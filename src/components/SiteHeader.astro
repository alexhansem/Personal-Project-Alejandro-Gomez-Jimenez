---
import { nav } from '../config/site';
import { profile } from '../config/profile';
import { url } from '../lib/url';

/** Monograma de la marca: iniciales del nombre (cambia solo con el perfil). */
const monograma = profile.name
  .split(/\s+/)
  .filter((w) => w.length > 2)
  .map((w) => w[0])
  .join('')
  .toUpperCase();
---

<header class="sh">
  <div class="sh__in">
    <a class="sh__brand" href={url('/')} aria-label={`${profile.name}, inicio`}>
      <i aria-hidden="true">{monograma}</i>
      <span>{profile.name}</span>
    </a>
    <nav aria-label="Principal">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)}>{item.label}</a>
            </li>
          ))
        }
        <li><a class="sh__cta" href={url('/#contacto')}>Cuéntame tu encargo</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .sh {
    position: sticky;
    top: 0;
    z-index: 20;
    background: #0c1b2ae6;
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--v-rule);
  }
  .sh__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px var(--v-gutter);
  }
  .sh__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .sh__brand i {
    font: 400 17px/1 var(--v-serif);
    font-style: normal;
    border: 1.5px solid var(--v-tx);
    padding: 6px 5px 4px;
  }
  ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 26px;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-size: 15px;
    text-decoration: none;
    opacity: 0.88;
  }
  nav a:hover {
    opacity: 1;
    color: var(--v-ac);
  }
  .sh__cta {
    opacity: 1;
    background: var(--v-ac);
    color: var(--v-bg);
    padding: 9px 16px;
    font-weight: 600;
  }
  nav .sh__cta:hover {
    color: var(--v-bg);
    background: var(--v-tx);
  }
  @media (max-width: 900px) {
    li:not(:last-child) {
      display: none;
    }
    .sh__brand span {
      font-size: 14.5px;
    }
    .sh__cta {
      padding: 8px 12px;
      font-size: 14px;
    }
  }
  @media (max-width: 400px) {
    .sh__brand span {
      display: none;
    }
  }
</style>
