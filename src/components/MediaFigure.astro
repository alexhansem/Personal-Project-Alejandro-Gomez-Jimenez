---
import type { MediaItem } from '../content/types';
import { url } from '../lib/url';
import Placeholder from './Placeholder.astro';

interface Props {
  item: MediaItem;
  /** Grupo de navegación del visor (normalmente el slug del proyecto). */
  group: string;
  /** Referencia tipo plano, ej. "D-01". */
  code?: string;
  loading?: 'lazy' | 'eager';
  showCaption?: boolean;
  /** Recortar a la proporción indicada en lugar de mostrar la imagen completa. */
  crop?: number;
  class?: string;
}

const { item, group, code, loading = 'lazy', showCaption = true, crop, class: cls } = Astro.props;
const ratio = crop ?? item.ratio ?? 1.414;
const src = item.src ? url(item.src) : undefined;
---

<figure class:list={['mf', cls]}>
  {
    src ? (
      <button
        type="button"
        class="mf__frame"
        data-viewer
        data-group={group}
        data-src={src}
        data-alt={item.alt}
        data-caption={item.caption ?? ''}
        aria-label={`Ampliar: ${item.caption ?? item.alt}`}
        style={`aspect-ratio: ${ratio}`}
      >
        <img
          src={src}
          alt={item.alt}
          loading={loading}
          decoding="async"
          class:list={['mf__img', { 'mf__img--crop': !!crop }]}
          data-media-img
        />
        <span class="mf__broken mono" aria-hidden="true">
          No se ha podido cargar la imagen
          <span>{item.src}</span>
        </span>
        <span class="mf__zoom mono" aria-hidden="true">Ampliar ⤢</span>
      </button>
    ) : (
      <Placeholder ratio={ratio} label={item.alt} kind={item.kind} />
    )
  }
  {
    showCaption && (item.caption || code) && (
      <figcaption class="mf__cap">
        {code && <span class="mf__code mono">{code}</span>}
        {item.caption && <span>{item.caption}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .mf {
    margin: 0;
    display: grid;
    gap: 10px;
    min-width: 0;
  }

  .mf__frame {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--line);
    background: var(--sheet);
    cursor: zoom-in;
    overflow: hidden;
  }

  .mf__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform var(--t) var(--ease);
  }

  .mf__img--crop {
    object-fit: cover;
    object-position: center;
  }

  .mf__frame:hover .mf__img {
    transform: scale(1.015);
  }

  .mf__zoom {
    position: absolute;
    right: 0;
    bottom: 0;
    padding: 6px 10px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    opacity: 0;
    transition: opacity var(--t-fast) var(--ease);
  }

  .mf__frame:hover .mf__zoom,
  .mf__frame:focus-visible .mf__zoom {
    opacity: 1;
  }

  .mf__broken {
    position: absolute;
    inset: 0;
    display: none;
    place-content: center;
    gap: 4px;
    padding: 16px;
    text-align: center;
    font-size: 0.75rem;
    color: var(--muted);
    background: var(--paper-2);
  }

  .mf__broken span {
    word-break: break-all;
  }

  .mf__frame[data-broken='true'] {
    cursor: default;
  }

  .mf__frame[data-broken='true'] .mf__broken {
    display: grid;
  }

  .mf__frame[data-broken='true'] .mf__img,
  .mf__frame[data-broken='true'] .mf__zoom {
    visibility: hidden;
  }

  .mf__cap {
    display: flex;
    gap: 12px;
    align-items: baseline;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .mf__code {
    flex: none;
    color: var(--accent);
    font-size: 0.75rem;
  }
</style>

<script>
  // Marca las imágenes que no cargan para mostrar un aviso en lugar de un hueco.
  const mark = (img: HTMLImageElement) => {
    const frame = img.closest<HTMLElement>('[data-viewer]');
    if (frame) frame.dataset.broken = 'true';
  };
  document.querySelectorAll<HTMLImageElement>('img[data-media-img]').forEach((img) => {
    if (img.complete && img.naturalWidth === 0 && img.currentSrc) mark(img);
    img.addEventListener('error', () => mark(img));
  });
</script>
