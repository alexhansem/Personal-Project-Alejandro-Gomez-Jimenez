---
interface Props {
  code: string;
  title: string;
  id?: string;
  level?: 'h1' | 'h2' | 'h3';
}
const { code, title, id, level = 'h2' } = Astro.props;
const Tag = level;
---

<div class="sh">
  <span class="sh__code mono" aria-hidden="true">{code}</span>
  <Tag class="sh__title" id={id}>{title}</Tag>
  <div class="sh__aside"><slot /></div>
</div>

<style>
  .sh {
    display: grid;
    grid-template-columns: 4rem 1fr auto;
    align-items: baseline;
    gap: 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--ink);
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .sh__code {
    color: var(--accent);
  }

  .sh__title {
    font-size: var(--step-2);
  }

  .sh__aside {
    justify-self: end;
  }

  @media (max-width: 560px) {
    .sh {
      grid-template-columns: 2.6rem 1fr;
    }

    .sh__aside {
      grid-column: 1 / -1;
      justify-self: start;
    }

    .sh__aside:empty {
      display: none;
    }
  }
</style>
