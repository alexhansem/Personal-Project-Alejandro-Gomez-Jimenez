---
/**
 * Proyecto en la portada para cualquier visitante: imagen grande, tiempo,
 * lo entregado y acceso directo a cada tipo de archivo.
 */
import type { Project } from '../content/types';
import { projectFiles, fileCount } from '../lib/files';
import { url } from '../lib/url';
import SpeedBadge from './SpeedBadge.astro';

interface Props {
  project: Project;
  code: string;
  /** Imagen a la derecha en lugar de a la izquierda. */
  flip?: boolean;
}
const { project: p, code, flip = false } = Astro.props;
const href = url(`/proyectos/${p.slug}/`);
const cover = p.cover ?? p.media?.[0];

// Una miniatura por tipo de archivo, enlazada a su grupo en la ficha.
const files = projectFiles(p).map((s) => ({
  id: s.id,
  label: s.label,
  count: fileCount(s),
  thumb:
    s.kind === 'modelo'
      ? s.model.poster
      : s.kind === 'presupuesto'
        ? p.skills?.find((k) => k.area === 'presupuesto')?.sample.src
        : s.kind === 'documentos'
          ? s.items.find((d) => d.thumb)?.thumb
          : s.items[0]?.src,
  contain: s.id === 'planos',
}));
---

<article class:list={['ps', { 'ps--flip': flip }]}>
  <a class="ps__media" href={href} tabindex="-1" aria-hidden="true">
    {cover?.src && <img src={url(cover.src)} alt="" loading="lazy" decoding="async" />}
  </a>

  <div class="ps__body">
    <p class="mono muted ps__meta">
      <span class="ps__code">{code}</span>
      {p.period && <span>{p.period}</span>}
    </p>
    <h3 class="ps__title"><a href={href}>{p.title}</a></h3>
    <p class="ps__tagline">{p.tagline ?? p.summary}</p>

    {p.speed && <SpeedBadge speed={p.speed} />}

    {
      !!p.delivered?.length && (
        <ul class="ps__delivered" aria-label="Entregado">
          {p.delivered.map((x) => (
            <li>
              <strong>{x.value}</strong> {x.label}
            </li>
          ))}
        </ul>
      )
    }

    <ul class="ps__files" aria-label="Archivos">
      {
        files.map((f) => (
          <li>
            <a href={`${href}#${f.id}`} class="ps__file">
              <span class:list={['ps__thumb', { 'ps__thumb--contain': f.contain }]}>
                {f.thumb && <img src={url(f.thumb)} alt="" loading="lazy" decoding="async" />}
              </span>
              <span class="ps__file-label">{f.label}</span>
              <span class="mono ps__file-n">{f.count}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <a class="btn btn--solid ps__cta" href={href}>Abrir el proyecto</a>
  </div>
</article>

<style>
  .ps {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: start;
  }

  .ps--flip .ps__media {
    order: 2;
  }

  .ps__media {
    display: block;
    aspect-ratio: 1.45;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--sheet);
  }

  .ps__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--t) var(--ease);
  }

  .ps__media:hover img {
    transform: scale(1.02);
  }

  .ps__body {
    display: grid;
    gap: 16px;
    align-content: start;
    justify-items: start;
  }

  .ps__meta {
    display: flex;
    gap: 14px;
    font-size: 0.75rem;
  }

  .ps__code {
    color: var(--accent);
  }

  .ps__title {
    font-size: var(--step-3);
    font-weight: 540;
    letter-spacing: -0.03em;
  }

  .ps__title a {
    text-decoration: none;
  }

  .ps__tagline {
    font-size: 1.0625rem;
    color: var(--ink-2);
    max-width: 52ch;
  }

  .ps__delivered {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.875rem;
  }

  .ps__delivered li {
    padding: 4px 10px;
    border: 1px solid var(--line);
    background: var(--sheet);
  }

  .ps__delivered strong {
    font-weight: 600;
  }

  .ps__files {
    list-style: none;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(118px, 1fr));
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--ink);
  }

  .ps__file {
    display: grid;
    gap: 4px;
    text-decoration: none;
  }

  .ps__thumb {
    display: block;
    aspect-ratio: 1.414;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--sheet);
    margin-bottom: 4px;
  }

  .ps__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ps__thumb--contain img {
    object-fit: contain;
    padding: 3px;
  }

  .ps__file:hover .ps__thumb {
    border-color: var(--ink);
  }

  .ps__file-label {
    font-size: 0.9375rem;
    font-weight: 560;
    line-height: 1.2;
  }

  .ps__file-n {
    font-size: 0.6875rem;
    color: var(--accent);
  }

  .ps__cta {
    margin-top: 4px;
  }

  @media (max-width: 960px) {
    .ps {
      grid-template-columns: 1fr;
    }

    .ps--flip .ps__media {
      order: 0;
    }
  }
</style>
