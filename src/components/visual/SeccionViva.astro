---
/**
 * Molde «Sección viva»: sección constructiva dibujada desde datos.
 * Con `montaje`, el edificio se monta en orden de obra al hacer scroll.
 */
import type { SeccionViva, CapaSeccion } from '../../visual/types';

interface Props {
  datos: SeccionViva;
  montaje?: boolean;
}
const { datos: d, montaje = false } = Astro.props;

const S = 30; // px por metro
const top = Math.max(...d.niveles.map((n) => n.cota)) + 1.5;
const x0 = Math.min(...d.ejes.map((e) => e.x));
const x1 = Math.max(...d.ejes.map((e) => e.x));
const OX = 3.4 * S;
const X = (m: number) => +(OX + (m - x0) * S).toFixed(1);
const Y = (m: number) => +((top - m) * S + 6).toFixed(1);
const W = X(x1) + 1.6 * S;
const H = Y(-1.5);
const fmt = (n: number) => String(n).replace('.', ',');
const cota = (n: number) => n.toFixed(2).replace('.', ',');

// Generador pseudoaleatorio fijo: el dibujo sale igual en cada build.
let seed = 11;
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280), seed / 233280);

const capas: Partial<Record<CapaSeccion, string>> = {};
const add = (c: CapaSeccion, s: string) => (capas[c] = (capas[c] ?? '') + s);

// Retícula, ejes y niveles
const yTopEje = top - 0.3;
d.ejes.forEach((e, i) => {
  add('reticula', `<line class="eje" x1="${X(e.x)}" y1="${Y(yTopEje)}" x2="${X(e.x)}" y2="${Y(-0.6)}"/>`);
  add('reticula', `<circle class="eje-c" cx="${X(e.x)}" cy="${Y(top - 0.05) + 4}" r="10"/><text x="${X(e.x)}" y="${Y(top - 0.05) + 8}" text-anchor="middle">${e.nombre}</text>`);
  const sig = d.ejes[i + 1];
  if (sig) add('reticula', `<text x="${(X(e.x) + X(sig.x)) / 2}" y="${Y(yTopEje) + 2}" text-anchor="middle">${cota(sig.x - e.x)}</text>`);
});
d.niveles.forEach((n) => {
  add('reticula', `<line class="nivel" x1="${X(x0 - 3)}" y1="${Y(n.cota)}" x2="${X(x0 - 1)}" y2="${Y(n.cota)}"/><text x="${X(x0 - 3)}" y="${Y(n.cota) - 5}">${n.etiqueta}</text>`);
});
add('reticula', `<line class="suelo" x1="${X(x0 - 3.2)}" y1="${Y(0)}" x2="${X(x1 + 1.4)}" y2="${Y(0)}"/>`);

if (d.pilares) {
  const p = d.pilares;
  p.x.forEach((x) => add('pilares', `<rect class="corte" x="${X(x - p.ancho / 2)}" y="${Y(p.hasta)}" width="${p.ancho * S}" height="${p.hasta * S}"/>`));
  add('pilares', `<text class="lbl" x="${X(p.x[1] ?? p.x[0]) + 10}" y="${Y(1.2)}">${p.etiqueta}</text>`);
}
d.forjados?.forEach((f) =>
  f.tramos.forEach(([a, b]) => add('forjados', `<line class="forjado" x1="${X(a)}" y1="${Y(f.cota)}" x2="${X(b)}" y2="${Y(f.cota)}"/>`)),
);
if (d.forjadoEtiqueta && d.forjados?.[0]) {
  // Encima del primer tramo de cubierta, donde no tapa pilares.
  const ult = d.forjados.at(-1)!;
  const [a, b] = ult.tramos[0];
  add('forjados', `<text class="lbl" x="${X((a + b) / 2)}" y="${Y(ult.cota) - 16}" text-anchor="middle">${d.forjadoEtiqueta}</text>`);
}
d.petos?.forEach((p) => add('petos', `<rect class="corte" x="${X(p.tramo[0])}" y="${Y(p.cota + p.alto)}" width="${(p.tramo[1] - p.tramo[0]) * S}" height="${p.alto * S}"/>`));
d.fondo?.forEach((f) => {
  add('fondo', `<path class="fondo" d="M${X(f.tramo[0])} ${Y(f.desde)} V${Y(f.hasta)} H${X(f.tramo[1])} V${Y(f.desde + 0.4)}"/>`);
  add('fondo', `<text class="lbl" x="${(X(f.tramo[0]) + X(f.tramo[1])) / 2}" y="${(Y(f.desde) + Y(f.hasta)) / 2 + 4}" text-anchor="middle">${f.etiqueta}</text>`);
});
d.cerramientos?.forEach((c) => {
  const [a, b] = c.tramo;
  add('cerramientos', `<rect class="cerr" x="${X(a)}" y="${Y(c.hasta)}" width="${(b - a) * S}" height="${(c.hasta - c.desde) * S}"/>`);
});
if (d.detalle) {
  const { x, cota } = d.detalle.en;
  add('detalle', `<circle class="lupa" cx="${X(x)}" cy="${Y(cota)}" r="14"/><line class="lupa-l" x1="${X(x) + 14}" y1="${Y(cota)}" x2="${W}" y2="${Y(cota)}"/>`);
}
d.vacios?.forEach((v) => {
  const [a, b] = v.tramo;
  if (v.vegetacion?.tipo === 'bambu') {
    const hMax = v.vegetacion.alturaMax;
    const n = Math.round((b - a) * 3.2);
    for (let i = 0; i < n; i++) {
      const x = a + 0.5 + rnd() * (b - a - 1);
      const h = hMax * (0.75 + rnd() * 0.25);
      const lean = (rnd() - 0.5) * 0.35;
      add('vacios', `<line class="bambu" x1="${X(x)}" y1="${Y(0)}" x2="${X(x + lean)}" y2="${Y(h)}" stroke-width="${(1.2 + rnd() * 0.8).toFixed(2)}"/>`);
      for (let k = 0.45; k < h; k += 0.45) {
        const xs = X(x + (lean * k) / h);
        add('vacios', `<line class="bambu" x1="${xs - 2}" y1="${Y(k)}" x2="${xs + 2}" y2="${Y(k)}" stroke-width="1"/>`);
      }
      for (let k = 0; k < 7; k++) {
        const t = 0.55 + rnd() * 0.45;
        const dir = rnd() < 0.5 ? -1 : 1;
        const L = 9 + rnd() * 9;
        add('vacios', `<path class="hoja" d="M${X(x + lean * t)} ${Y(h * t)} q${(dir * L * 0.5).toFixed(1)} -3 ${(dir * L).toFixed(1)} ${(2 + rnd() * 4).toFixed(1)}"/>`);
      }
    }
    const yc = Y(hMax + 0.6);
    add('vacios', `<path class="cota-ac" d="M${X(a)} ${yc} H${X(b)} M${X(a)} ${yc - 5} V${yc + 5} M${X(b)} ${yc - 5} V${yc + 5}"/>`);
  }
  if (v.cota) add('vacios', `<text class="ac" x="${(X(a) + X(b)) / 2}" y="${Y((v.vegetacion?.alturaMax ?? 3) + 0.6) - 7}" text-anchor="middle">${v.cota}</text>`);
  add('vacios', `<text class="ac" x="${(X(a) + X(b)) / 2}" y="${Y(-1)}" text-anchor="middle">${v.etiqueta}</text>`);
});

// Paso en el que aparece cada capa (para el montaje).
const pasoDe = (c: CapaSeccion) => {
  const i = d.pasos.findIndex((p) => p.capas.includes(c));
  return i < 0 ? 0 : i;
};
const orden: CapaSeccion[] = ['reticula', 'fondo', 'vacios', 'pilares', 'forjados', 'petos', 'cerramientos', 'detalle'];
const svg = orden
  .filter((c) => capas[c])
  .map((c) => `<g class="sv-capa" data-paso="${pasoDe(c)}">${capas[c]}</g>`)
  .join('');

const total = d.detalle?.capas.reduce((s, c) => s + c.cm, 0) ?? 0;
const pasoDetalle = pasoDe('detalle');
---

<div class:list={['sv', { 'sv-montaje': montaje }]} style={montaje ? `--pasos:${d.pasos.length}` : undefined} data-sv>
  <div class="sv-pin">
    {
      montaje && (
        <ol class="sv-pasos" aria-label="Orden de montaje">
          {d.pasos.map((p, i) => (
            <li data-paso={i}>
              <span>{i + 1}</span>
              {p.titulo}
            </li>
          ))}
        </ol>
      )
    }
    <div class="sv-dibujo">
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${d.titulo}. ${d.fuente}`} set:html={svg} />
      {
        d.detalle && (
          <aside class="sv-capa sv-detalle" data-paso={pasoDetalle}>
            <p class="sv-dt">{d.detalle.titulo}</p>
            <p class="v-note">{d.detalle.fuente}</p>
            <p class="sv-io">
              <span>interior</span>
              <span>exterior</span>
            </p>
            <div class="sv-tira">
              {d.detalle.capas.map((c) => (
                <i
                  style={`flex:${c.cm}`}
                  class:list={{ ac: c.destacar, hueco: c.hueco }}
                  title={`${c.nombre} · ${fmt(c.cm)} cm`}
                />
              ))}
            </div>
            <ol class="sv-capas">
              {d.detalle.capas.map((c) => (
                <li class:list={{ ac: c.destacar }}>
                  {c.nombre} <b>{fmt(c.cm)}</b>
                </li>
              ))}
            </ol>
            <p class="v-note">Total {fmt(total)} cm, de interior a exterior.</p>
          </aside>
        )
      }
    </div>
    {d.notas?.map((n) => <p class="v-note sv-nota">{n}</p>)}
  </div>
</div>

<style>
  .sv {
    position: relative;
  }
  .sv-pin {
    display: grid;
    gap: 14px;
  }
  .sv-montaje {
    height: calc(var(--pasos) * 70vh + 40vh);
  }
  .sv-montaje .sv-pin {
    position: sticky;
    top: 0;
    min-height: 100vh;
    align-content: center;
    padding: 24px 0;
  }
  .sv-dibujo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 230px;
    gap: 8px;
    align-items: center;
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  :global(.sv-capa) {
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  :global(.sv-js .sv-capa:not(.on)) {
    opacity: 0;
    transform: translateY(10px);
  }
  svg :global(text) {
    font: 13px var(--v-sans);
    fill: var(--v-mu);
  }
  svg :global(.lbl) {
    fill: var(--v-tx);
    opacity: 0.85;
  }
  svg :global(.ac) {
    fill: var(--v-ac);
  }
  svg :global(.eje) {
    stroke: var(--v-mu);
    stroke-width: 0.6;
    stroke-dasharray: 6 4 1 4;
    opacity: 0.55;
  }
  svg :global(.eje-c) {
    fill: none;
    stroke: var(--v-mu);
    stroke-width: 0.8;
  }
  svg :global(.nivel) {
    stroke: var(--v-mu);
    stroke-width: 0.7;
  }
  svg :global(.suelo) {
    stroke: var(--v-tx);
    stroke-width: 1.4;
  }
  svg :global(.corte) {
    fill: var(--v-tx);
  }
  svg :global(.forjado) {
    stroke: var(--v-tx);
    stroke-width: 4;
  }
  svg :global(.fondo) {
    fill: none;
    stroke: var(--v-mu);
    stroke-dasharray: 3 3;
    opacity: 0.8;
  }
  svg :global(.cerr) {
    fill: var(--v-bg);
    stroke: var(--v-tx);
  }
  svg :global(.lupa) {
    fill: none;
    stroke: var(--v-ac);
    stroke-width: 1.4;
  }
  svg :global(.lupa-l),
  svg :global(.cota-ac) {
    stroke: var(--v-ac);
    stroke-width: 0.8;
    fill: none;
  }
  svg :global(.bambu) {
    stroke: var(--v-ac);
  }
  svg :global(.hoja) {
    stroke: var(--v-ac);
    stroke-width: 2.2;
    stroke-linecap: round;
    fill: none;
    opacity: 0.85;
  }
  .sv-detalle {
    border-left: 1px solid var(--v-ac);
    padding-left: 14px;
    display: grid;
    gap: 6px;
  }
  .sv-dt {
    font: 400 22px/1.1 var(--v-serif);
  }
  .sv-io {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--v-mu);
    margin-top: 6px;
  }
  .sv-tira {
    display: flex;
    height: 90px;
  }
  .sv-tira i {
    background: var(--v-ln);
    opacity: 0.85;
  }
  .sv-tira i:nth-child(even) {
    background: var(--v-tx);
  }
  .sv-tira i.hueco {
    background: transparent;
    outline: 1px dashed #ffffff40;
    outline-offset: -1px;
  }
  .sv-tira i.ac {
    background: var(--v-ac);
    opacity: 1;
  }
  .sv-capas {
    list-style: none;
    padding: 0;
    margin: 4px 0 0;
    font-size: 12.5px;
    color: var(--v-mu);
    counter-reset: c;
  }
  .sv-capas li {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid var(--v-rule);
    padding: 2px 0;
  }
  .sv-capas b {
    font-weight: 500;
    color: var(--v-tx);
  }
  .sv-capas li.ac,
  .sv-capas li.ac b {
    color: var(--v-ac);
  }
  .sv-pasos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-size: 14px;
    color: var(--v-mu);
  }
  .sv-pasos li {
    transition: color 0.3s;
  }
  .sv-pasos span {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 11px;
    margin-right: 8px;
  }
  .sv-pasos li.on {
    color: var(--v-tx);
  }
  .sv-pasos li.cur {
    color: var(--v-ac);
  }
  .sv-nota {
    margin-top: 2px;
  }
  @media (max-width: 860px) {
    .sv-dibujo {
      grid-template-columns: 1fr;
    }
    .sv-detalle {
      border-left: 0;
      border-top: 1px solid var(--v-ac);
      padding: 12px 0 0;
    }
    .sv-tira {
      height: 48px;
    }
    svg :global(text) {
      font-size: 20px;
    }
    svg :global(.lbl) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.sv-capa) {
      transition: none;
    }
  }
</style>

<script>
  // Montaje por orden de obra: cada tramo de scroll añade un paso.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-sv].sv-montaje').forEach((el) => {
    if (reduce) return;
    el.classList.add('sv-js');
    const capas = [...el.querySelectorAll<HTMLElement | SVGGElement>('.sv-capa')];
    const pasos = [...el.querySelectorAll<HTMLElement>('.sv-pasos li')];
    const n = pasos.length;
    let actual = -1;
    const pintar = () => {
      const r = el.getBoundingClientRect();
      const recorrido = el.offsetHeight - innerHeight;
      const t = Math.min(1, Math.max(0, -r.top / Math.max(1, recorrido)));
      const paso = Math.min(n - 1, Math.floor(t * n * 1.05));
      if (paso === actual) return;
      actual = paso;
      capas.forEach((c) => c.classList.toggle('on', Number(c.dataset.paso) <= paso));
      pasos.forEach((p, i) => {
        p.classList.toggle('on', i <= paso);
        p.classList.toggle('cur', i === paso);
      });
    };
    pintar();
    addEventListener('scroll', pintar, { passive: true });
    addEventListener('resize', pintar);
  });
</script>
