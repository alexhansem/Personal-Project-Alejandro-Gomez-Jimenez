---
/**
 * Molde «Plantas apiladas»: plantas reales separadas en 3D, con una zona
 * destacada (p. ej. el patio con vegetación). La parcela solo va en planta baja:
 * eso se resuelve al generar las máscaras (ver tools/visual/README.md).
 */
import type { PlantasApiladas } from '../../visual/types';
import { url } from '../../lib/url';

interface Props {
  datos: PlantasApiladas;
}
const { datos: d } = Astro.props;

const W = 640;
const H = Math.round(W / d.ratio);
const GAP = 150;
const op = [1, 0.78, 0.6, 0.5];
const z = d.destacado;

let seed = 7;
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280), seed / 233280);

// Vegetación vista desde arriba (matas) y cañas de pie, en coordenadas del patio.
let arriba = '';
const cañas: string[] = [];
const PW = z ? (W * z.width) / 100 : 0;
const PH = z ? (H * z.height) / 100 : 0;
if (z?.vegetacion === 'bambu') {
  const franjas: [number, number][] = [
    [0.03, 0.4],
    [0.6, 0.97],
  ];
  franjas.forEach(([a, b]) => {
    for (let y = 0.03; y < 0.99; y += 0.045) {
      for (let c = 0; c < 2; c++) {
        const cx = (a + (b - a) * (0.15 + rnd() * 0.7)) * PW;
        const cy = (y + rnd() * 0.03) * PH;
        const r = 9 + rnd() * 4;
        for (let k = 0; k < 14; k++) {
          const an = k * 26 + rnd() * 20;
          arriba += `<ellipse cx="${cx.toFixed(1)}" cy="${(cy - r * 0.55).toFixed(1)}" rx="${(r * 0.2).toFixed(1)}" ry="${(r * 0.75).toFixed(1)}" transform="rotate(${an.toFixed(0)} ${cx.toFixed(1)} ${cy.toFixed(1)})" fill-opacity="${(0.35 + rnd() * 0.4).toFixed(2)}"/>`;
        }
        arriba += `<circle class="n" cx="${cx.toFixed(1)}" cy="${cy.toFixed(1)}" r="${(r * 0.22).toFixed(1)}"/>`;
      }
    }
  });
  const Z = 135;
  franjas.forEach(([a, b]) =>
    [0.33, 0.67].forEach((t) => {
      const x = (a + (b - a) * t) * PW;
      let s = '';
      for (let y = 4; y < PH - 3; y += 8 + rnd() * 6) {
        const h = Z * (0.7 + rnd() * 0.3);
        const yy = y + (rnd() - 0.5) * 8;
        s += `<line x1="0" y1="${y.toFixed(1)}" x2="${h.toFixed(1)}" y2="${yy.toFixed(1)}" stroke-width="${(1 + rnd() * 0.8).toFixed(2)}" opacity="${(0.45 + rnd() * 0.4).toFixed(2)}"/>`;
        for (let n = h * 0.2; n < h; n += h * 0.18) s += `<line x1="${n.toFixed(1)}" y1="${(y - 1.4).toFixed(1)}" x2="${n.toFixed(1)}" y2="${(y + 1.4).toFixed(1)}" stroke-width=".9"/>`;
        for (let l = 0; l < 5; l++) {
          const lx = h * (0.4 + rnd() * 0.6);
          const ly = y + (yy - y) * (lx / h);
          const dir = rnd() > 0.5 ? 1 : -1;
          const len = 10 + rnd() * 12;
          s += `<path d="M${lx.toFixed(1)} ${ly.toFixed(1)} q ${(-len * 0.5).toFixed(1)} ${(dir * len * 0.35).toFixed(1)} ${(-len).toFixed(1)} ${(dir * len * 0.6).toFixed(1)}" stroke-width="${(1.2 + rnd()).toFixed(2)}" fill="none" stroke-linecap="round" opacity="${(0.4 + rnd() * 0.45).toFixed(2)}"/>`;
        }
      }
      cañas.push(`<div class="pa-cañas" style="left:${x.toFixed(1)}px;width:${Z}px"><svg viewBox="0 0 ${Z} ${PH.toFixed(1)}" preserveAspectRatio="none">${s}</svg></div>`);
    }),
  );
}
const zona = z ? `left:${z.left}%;top:${z.top}%;width:${z.width}%;height:${z.height}%` : '';
---

<div class="pa" data-pa role="img" aria-label={`${d.plantas.map((p) => `${p.nombre}: ${p.dato}`).join('. ')}. ${d.fuente}`}>
  <div class="pa-stack" style={`width:${W}px;height:${H}px;margin-left:${-W / 2}px;margin-top:${-H / 2}px`}>
    <div class="pa-base"></div>
    {
      d.plantas.map((p, i) => (
        <>
          <div
            class="pa-lay"
            data-i={i}
            style={`-webkit-mask-image:url(${url(p.mascara)});mask-image:url(${url(p.mascara)});opacity:${op[i] ?? 0.5};transform:translateZ(${i * GAP + 1}px)`}
          />
          {z && (
            <div class={i === 0 ? 'pa-zona' : 'pa-hueco'} style={`${zona};transform:translateZ(${i * GAP + 2}px)`}>
              {i === 0 && <svg class="pa-top" viewBox={`0 0 ${PW} ${PH}`} set:html={arriba} />}
              {i === 0 && <Fragment set:html={cañas.join('')} />}
            </div>
          )}
        </>
      ))
    }
  </div>
  {
    d.plantas.map((p, i) => (
      <p class="pa-tag" data-tag={i}>
        <b>{p.nombre}</b>
        <br />
        {p.dato}
      </p>
    ))
  }
  {
    z && (
      <p class="pa-tag pa-tag-z" data-tag="z">
        <b>{z.nombre}</b> · <span>{z.medida}</span>
      </p>
    )
  }
</div>

<style>
  .pa {
    position: relative;
    height: min(78svh, 720px);
    min-height: 420px;
  }
  .pa-stack {
    position: absolute;
    left: 46%;
    top: 50%;
    transform: rotateX(58deg) rotateZ(-38deg) scale(var(--s, 0.78));
    transform-style: preserve-3d;
  }
  .pa-base {
    position: absolute;
    inset: -14px;
    border: 1px solid #c9d6e233;
    background: #12263acc;
  }
  .pa-lay {
    position: absolute;
    inset: 0;
    background: var(--v-ln);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }
  .pa-hueco {
    position: absolute;
    outline: 1.5px solid var(--v-ac);
    outline-offset: -1px;
  }
  .pa-zona {
    position: absolute;
    background: #ff6b3d26;
    outline: 1.5px solid var(--v-ac);
    transform-style: preserve-3d;
  }
  .pa-top {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: var(--v-ac);
  }
  .pa-top :global(.n) {
    fill: #ff8a63;
  }
  .pa-zona :global(.pa-cañas) {
    position: absolute;
    top: 0;
    height: 100%;
    transform-origin: 0 50%;
    transform: rotateY(-90deg);
    overflow: visible;
  }
  .pa-zona :global(.pa-cañas svg) {
    width: 100%;
    height: 100%;
    overflow: visible;
    stroke: var(--v-ac);
  }
  .pa-tag {
    position: absolute;
    left: 0;
    top: 0;
    visibility: hidden;
    line-height: 1.5;
    font-size: 12.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--v-mu);
    white-space: nowrap;
  }
  .pa-tag b {
    color: var(--v-tx);
    font-weight: 600;
  }
  .pa-tag::before {
    content: '';
    display: inline-block;
    width: 40px;
    height: 1px;
    background: var(--v-mu);
    vertical-align: middle;
    margin-right: 10px;
  }
  .pa-tag-z b {
    color: var(--v-ac);
  }
  .pa-tag-z span {
    text-transform: none;
    letter-spacing: 0.02em;
  }
  @media (max-width: 700px) {
    .pa {
      height: 540px;
      min-height: 0;
    }
    .pa-stack {
      left: 46%;
      top: 60%;
    }
    .pa-tag {
      font-size: 11px;
    }
    .pa-tag::before {
      width: 16px;
      margin-right: 6px;
    }
  }
</style>

<script>
  // Escala la maqueta al ancho disponible y coloca las etiquetas junto a cada planta.
  const colocar = (el: HTMLElement) => {
    const stack = el.querySelector<HTMLElement>('.pa-stack')!;
    const E = el.getBoundingClientRect();
    const s = Math.min(0.78, E.width / 900, E.height / 820);
    stack.style.setProperty('--s', String(s));
    requestAnimationFrame(() => {
      const E2 = el.getBoundingClientRect();
      el.querySelectorAll<HTMLElement>('.pa-lay').forEach((ly) => {
        const tag = el.querySelector<HTMLElement>(`[data-tag="${ly.dataset.i}"]`);
        if (!tag) return;
        const r = ly.getBoundingClientRect();
        tag.style.left = `${Math.min(r.right - E2.left + 8, E2.width - tag.offsetWidth - 4)}px`;
        tag.style.top = `${r.top - E2.top + r.height * 0.4}px`;
        tag.style.visibility = 'visible';
      });
      const z = el.querySelector<HTMLElement>('.pa-zona');
      const tz = el.querySelector<HTMLElement>('[data-tag="z"]');
      if (z && tz) {
        const r = z.getBoundingClientRect();
        tz.style.left = `${Math.max(0, Math.min(r.left - E2.left + r.width * 0.3, E2.width - tz.offsetWidth - 4))}px`;
        tz.style.top = `${r.bottom - E2.top + 14}px`;
        tz.style.visibility = 'visible';
      }
    });
  };
  const todos = [...document.querySelectorAll<HTMLElement>('[data-pa]')];
  const ro = new ResizeObserver((es) => es.forEach((e) => colocar(e.target as HTMLElement)));
  todos.forEach((el) => ro.observe(el));
</script>
