---
/**
 * Presupuesto por mediciones, partida a partida. Capítulos plegables con su
 * barra de importe, filtro por ámbito y búsqueda. Sin JS se ve completo.
 */
import type { ProjectBudget } from '../content/types';
import { url } from '../lib/url';

interface Props {
  budget: ProjectBudget;
}
const { budget: b } = Astro.props;

const eur = (n: number, digits = 0) =>
  n.toLocaleString('es-ES', { minimumFractionDigits: digits, maximumFractionDigits: digits, useGrouping: 'always' });
const num = (n: number) => n.toLocaleString('es-ES', { maximumFractionDigits: 2, useGrouping: 'always' });

const total = b.lines.reduce((a, l) => a + l.amount, 0);
const chapters = [...new Set(b.lines.map((l) => l.chapter))]
  .map((name) => {
    const lines = b.lines.filter((l) => l.chapter === name).sort((x, y) => y.amount - x.amount);
    return { name, lines, amount: lines.reduce((a, l) => a + l.amount, 0) };
  })
  .sort((x, y) => y.amount - x.amount);
const max = Math.max(...chapters.map((c) => c.amount));
const scopes = Object.entries(b.scopes);
const example = b.example ? b.lines.find((l) => l.code === b.example!.code && l.scope === b.example!.scope) : undefined;
// Las mediciones salen sin redondear: si viviendas × medición redondeada no da exacto, se indica con ≈.
const eq = (l: (typeof b.lines)[number]) =>
  l.dwellings && l.each !== undefined && Math.abs(l.dwellings * l.each - l.qty) < 0.005 ? '=' : '≈';
const sourceLabel = (l: (typeof b.lines)[number]) =>
  l.source === 'mercado'
    ? 'Precio de mercado (hipótesis)'
    : l.source === 'porcentaje'
      ? 'Porcentaje estimado'
      : `Precio CYPE ${l.code}`;
---

<div class="bx" data-budget>
  <dl class="bx__sum">
    <div>
      <dt class="label">Partidas medidas</dt>
      <dd class="bx__big">{b.lines.length}</dd>
    </div>
    <div>
      <dt class="label">Capítulos</dt>
      <dd class="bx__big">{chapters.length}</dd>
    </div>
    <div>
      <dt class="label">Total de la obra</dt>
      <dd class="bx__big">{eur(total)} €</dd>
    </div>
    {
      b.dwellings && (
        <div>
          <dt class="label">Por vivienda</dt>
          <dd class="bx__big">≈ {eur(Math.round(total / b.dwellings / 1000) * 1000)} €</dd>
        </div>
      )
    }
  </dl>

  {
    example && (
      <section class="bx__ex" aria-labelledby="bx-ejemplo">
        <h4 class="bx__ex-h" id="bx-ejemplo">
          Así sale una partida: <span>{example.desc.toLowerCase()}</span>
        </h4>
        <ol class="bx__ex-steps">
          <li>
            <span class="mono bx__ex-n">01 · Medir en el plano</span>
            <span class="bx__ex-v">
              {num(example.each ?? example.qty)} {example.unit}
            </span>
            <span class="bx__ex-t">{example.how} Por vivienda.</span>
          </li>
          {example.dwellings && (
            <li>
              <span class="mono bx__ex-n">02 · Por las viviendas iguales</span>
              <span class="bx__ex-v">
                × {example.dwellings} {eq(example)} {num(example.qty)} {example.unit}
              </span>
              <span class="bx__ex-t">{b.scopes[example.scope]}: la misma distribución en las plantas 1ª, 2ª y 3ª.</span>
            </li>
          )}
          <li>
            <span class="mono bx__ex-n">{example.dwellings ? '03' : '02'} · Precio para esta obra</span>
            <span class="bx__ex-v">
              {eur(example.price, 2)} €/{example.unit}
            </span>
            <span class="bx__ex-t">Generador de precios de CYPE, partida {example.code}, ajustado a esta obra.</span>
          </li>
          <li>
            <span class="mono bx__ex-n">{example.dwellings ? '04' : '03'} · Importe</span>
            <span class="bx__ex-v bx__ex-v--accent">{eur(example.amount, 2)} €</span>
            <span class="bx__ex-t">
              {num(example.qty)} {example.unit} × {eur(example.price, 2)} €. Lo mismo, partida a partida, hasta las{' '}
              {b.lines.length}.
            </span>
          </li>
        </ol>
      </section>
    )
  }

  <div class="bx__tools">
    <div class="bx__scopes" role="group" aria-label="Filtrar por ámbito">
      <button type="button" class="bx__scope" aria-pressed="true" data-scope="">Todo</button>
      {
        scopes.map(([key, label]) => (
          <button type="button" class="bx__scope" aria-pressed="false" data-scope={key}>
            {label}
          </button>
        ))
      }
    </div>
    <label class="bx__search">
      <span class="visually-hidden">Buscar partida</span>
      <input type="search" placeholder="Buscar: ventana, aerotermia, alicatado…" data-search autocomplete="off" />
    </label>
  </div>

  <p class="mono muted bx__status" aria-live="polite" data-status>
    Mostrando {b.lines.length} partidas · {eur(total)} €
  </p>

  <ol class="bx__chapters">
    {
      chapters.map((c, i) => (
        <li data-chapter>
          <details class="bx__ch" open={i === 0}>
            <summary class="bx__ch-sum">
              <span class="bx__ch-name">{c.name}</span>
              <span class="bx__bar" aria-hidden="true">
                <span style={`width: ${((c.amount / max) * 100).toFixed(1)}%`} data-bar />
              </span>
              <span class="mono bx__ch-n" data-count>
                {c.lines.length} partidas
              </span>
              <span class="bx__ch-amount" data-amount>
                {eur(c.amount)} €
              </span>
            </summary>
            <div class="bx__table-wrap">
              <table class="bx__table">
                <thead>
                  <tr>
                    <th scope="col">Partida</th>
                    <th scope="col">Ámbito</th>
                    <th scope="col" class="n">Medición</th>
                    <th scope="col" class="n">Precio</th>
                    <th scope="col" class="n">Importe</th>
                  </tr>
                </thead>
                <tbody>
                  {c.lines.map((l) => (
                    <tr data-line data-scope={l.scope} data-amount={l.amount} data-text={`${l.code} ${l.desc}`.toLowerCase()}>
                      <td>
                        <span class="mono bx__code">{l.code}</span>
                        <span class="bx__desc">{l.desc}</span>
                        {l.how && (
                          <span class="bx__how">
                            <span class="bx__how-k">Cómo se mide:</span> {l.how}
                            {l.dwellings && l.each !== undefined && (
                              <span class="mono bx__calc">
                                {l.dwellings} viv. × {num(l.each)} {l.unit} {eq(l)} {num(l.qty)} {l.unit}
                              </span>
                            )}
                          </span>
                        )}
                        {l.source && (
                          <span class:list={['mono', 'bx__src', { 'bx__src--mkt': l.source !== 'cype' }]}>
                            {sourceLabel(l)}
                          </span>
                        )}
                      </td>
                      <td class="bx__where">{b.scopes[l.scope] ?? l.scope}</td>
                      <td class="n" data-label="Medición">
                        {num(l.qty)} {l.unit}
                      </td>
                      <td class="n" data-label="Precio">
                        {eur(l.price, 2)} €/{l.unit}
                      </td>
                      <td class="n bx__amount" data-label="Importe">
                        {eur(l.amount, 2)} €
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        </li>
      ))
    }
  </ol>

  <div class="bx__foot">
    {b.note && <p class="muted bx__note">{b.note}</p>}
    {
      !!b.downloads?.length && (
        <div class="bx__downloads">
          {b.downloads.map((d) => (
            <a class="btn" href={url(d.src)} download>
              Descargar {d.label}
              {d.hint && <span class="mono muted bx__dl-hint">{d.hint}</span>}
            </a>
          ))}
        </div>
      )
    }
  </div>
</div>

<style>
  .bx {
    display: grid;
    gap: 18px;
  }

  .bx__sum {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    column-gap: 20px;
    margin: 0;
    border-top: 1.5px solid var(--ink);
  }

  .bx__sum div {
    display: grid;
    gap: 4px;
    padding: 14px 0 16px;
    border-bottom: 1px solid var(--line);
  }

  .bx__sum dd {
    margin: 0;
  }

  .bx__big {
    font-size: var(--step-2);
    font-weight: 560;
    letter-spacing: -0.02em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .bx__tools {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 320px);
    gap: 12px 24px;
    align-items: start;
  }

  .bx__scopes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .bx__scope {
    padding: 7px 12px;
    border: 1px solid var(--line);
    background: var(--sheet);
    font-size: 0.875rem;
    cursor: pointer;
  }

  .bx__scope:hover {
    border-color: var(--ink);
  }

  .bx__scope[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .bx__search input {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid var(--line);
    background: var(--sheet);
    font: inherit;
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .bx__search input:focus {
    border-color: var(--ink);
    outline: none;
  }

  .bx__status {
    font-size: 0.75rem;
  }

  .bx__chapters {
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .bx__chapters > li {
    border-bottom: 1px solid var(--line);
  }

  .bx__chapters > li[hidden] {
    display: none;
  }

  .bx__ch-sum {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr) 6.5rem 7.5rem 1.2rem;
    gap: 16px;
    align-items: center;
    padding: 12px 0;
    cursor: pointer;
    list-style: none;
  }

  .bx__ch-sum::-webkit-details-marker {
    display: none;
  }

  .bx__ch-sum::after {
    content: '+';
    font-family: var(--font-mono);
    color: var(--accent);
    text-align: right;
  }

  .bx__ch[open] > .bx__ch-sum::after {
    content: '−';
  }

  .bx__ch-sum:hover .bx__ch-name {
    color: var(--accent);
  }

  .bx__ch-name {
    font-weight: 560;
  }

  .bx__bar {
    height: 10px;
    background: var(--paper-3);
  }

  .bx__bar span {
    display: block;
    height: 100%;
    background: var(--accent);
    transition: width var(--t) var(--ease);
  }

  .bx__ch-n {
    font-size: 0.75rem;
    color: var(--muted);
    text-align: right;
  }

  .bx__ch-amount {
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-weight: 560;
  }

  .bx__table-wrap {
    padding-bottom: 16px;
    overflow-x: auto;
  }

  .bx__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .bx__table th {
    padding: 8px 10px 8px 0;
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: left;
  }

  .bx__table td {
    padding: 9px 10px 9px 0;
    border-bottom: 1px solid var(--line-soft);
    vertical-align: top;
  }

  .bx__table .n {
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .bx__table tr[hidden] {
    display: none;
  }

  .bx__code {
    display: block;
    font-size: 0.6875rem;
    color: var(--accent);
  }

  .bx__desc {
    display: block;
    max-width: 60ch;
  }

  .bx__how {
    display: block;
    margin-top: 4px;
    max-width: 64ch;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  .bx__how-k {
    font-weight: 560;
  }

  .bx__calc {
    display: block;
    margin-top: 2px;
    font-size: 0.75rem;
    color: var(--ink);
  }

  .bx__src {
    display: inline-block;
    margin-top: 6px;
    padding: 1px 6px;
    border: 1px solid var(--line);
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .bx__src--mkt {
    border-style: dashed;
  }

  .bx__ex {
    padding: clamp(18px, 2.5vw, 28px);
    background: var(--sheet);
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
  }

  .bx__ex-h {
    font-size: var(--step-1);
    margin-bottom: 16px;
  }

  .bx__ex-h span {
    font-weight: 400;
    color: var(--ink-2);
  }

  .bx__ex-steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px 24px;
  }

  .bx__ex-steps li {
    display: grid;
    gap: 6px;
    align-content: start;
    padding-top: 10px;
    border-top: 1px solid var(--ink);
  }

  .bx__ex-n {
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--accent);
  }

  .bx__ex-v {
    font-size: var(--step-2);
    font-weight: 560;
    letter-spacing: -0.02em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .bx__ex-v--accent {
    color: var(--accent);
  }

  .bx__ex-t {
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .bx__where {
    color: var(--ink-2);
    min-width: 11rem;
  }

  .bx__amount {
    font-weight: 560;
  }

  .bx__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: start;
    gap: 16px 32px;
  }

  .bx__note {
    font-size: 0.875rem;
    max-width: 70ch;
  }

  .bx__downloads {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .bx__dl-hint {
    margin-left: 8px;
    font-size: 0.6875rem;
  }

  @media (max-width: 760px) {
    .bx__tools {
      grid-template-columns: 1fr;
    }

    .bx__ch-sum {
      grid-template-columns: minmax(0, 1fr) auto 1rem;
      grid-template-areas: 'name amount plus' 'bar bar bar';
      gap: 6px 12px;
    }

    .bx__ch-name {
      grid-area: name;
    }

    .bx__ch-amount {
      grid-area: amount;
    }

    .bx__ch-sum::after {
      grid-area: plus;
    }

    .bx__bar {
      grid-area: bar;
      height: 6px;
    }

    .bx__ch-n {
      display: none;
    }

    .bx__table thead {
      display: none;
    }

    .bx__table,
    .bx__table tbody,
    .bx__table tr,
    .bx__table td {
      display: block;
    }

    .bx__table tr {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2px 12px;
      padding: 10px 0;
      border-bottom: 1px solid var(--line-soft);
    }

    .bx__table tr[hidden] {
      display: none;
    }

    .bx__table td {
      padding: 0;
      border: 0;
    }

    .bx__table td:first-child,
    .bx__table .bx__where {
      grid-column: 1 / -1;
    }

    .bx__table .bx__where {
      min-width: 0;
      font-size: 0.8125rem;
      margin-bottom: 4px;
    }

    .bx__table .n {
      text-align: left;
    }

    .bx__table .n::before {
      content: attr(data-label) ' · ';
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      color: var(--muted);
    }
  }
</style>

<script>
  const fmt = (n: number) => `${Math.round(n).toLocaleString('es-ES', { useGrouping: 'always' })} €`;

  document.querySelectorAll<HTMLElement>('[data-budget]').forEach((root) => {
    const scopeBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-scope]')];
    const search = root.querySelector<HTMLInputElement>('[data-search]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const chapters = [...root.querySelectorAll<HTMLElement>('[data-chapter]')];
    let scope = '';

    const apply = () => {
      const q = search.value.trim().toLowerCase();
      const words = q.split(/\s+/).filter(Boolean);
      const amounts = chapters.map((ch) => {
        let sum = 0;
        let n = 0;
        ch.querySelectorAll<HTMLElement>('[data-line]').forEach((row) => {
          const ok =
            (!scope || row.dataset.scope === scope) && words.every((w) => (row.dataset.text ?? '').includes(w));
          row.hidden = !ok;
          if (ok) {
            sum += Number(row.dataset.amount);
            n++;
          }
        });
        return { ch, sum, n };
      });
      const max = Math.max(1, ...amounts.map((a) => a.sum));
      let total = 0;
      let count = 0;
      for (const { ch, sum, n } of amounts) {
        ch.hidden = n === 0;
        ch.querySelector<HTMLElement>('[data-bar]')!.style.width = `${((sum / max) * 100).toFixed(1)}%`;
        ch.querySelector<HTMLElement>('[data-amount]')!.textContent = fmt(sum);
        ch.querySelector<HTMLElement>('[data-count]')!.textContent = `${n} ${n === 1 ? 'partida' : 'partidas'}`;
        // Con una búsqueda activa se abren los capítulos con resultados.
        if (words.length) ch.querySelector('details')!.open = n > 0;
        total += sum;
        count += n;
      }
      status.textContent = count
        ? `Mostrando ${count} ${count === 1 ? 'partida' : 'partidas'} · ${fmt(total)}`
        : 'Ninguna partida coincide con la búsqueda';
    };

    scopeBtns.forEach((btn) =>
      btn.addEventListener('click', () => {
        scope = btn.dataset.scope ?? '';
        scopeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        apply();
      }),
    );
    search.addEventListener('input', apply);
  });
</script>
