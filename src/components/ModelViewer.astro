---
/**
 * Modelo 3D interactivo. Muestra primero una imagen fija del modelo; three.js y
 * el GLB solo se descargan cuando se pulsa «Abrir modelo 3D».
 */
import type { ProjectModel } from '../content/types';
import { url } from '../lib/url';

interface Props {
  model: ProjectModel;
}
const { model: m } = Astro.props;
const storeys = m.storeys ?? [];
---

<figure class="mv" data-model-viewer data-src={url(m.src)} data-storeys={storeys.map((s) => s.key).join(',')} data-state="idle">
  <div class="mv__stage" data-mv-stage>
    {m.poster && <img class="mv__poster" src={url(m.poster)} alt={m.alt} loading="lazy" decoding="async" />}
    <button type="button" class="mv__open" data-mv-open>
      <span class="mv__open-label">Abrir modelo 3D</span>
      <span class="mono mv__open-sub">{m.size ? `${m.size} · ` : ''}arrastra para girar</span>
    </button>
    <p class="mv__status mono" data-mv-status hidden>Cargando modelo…</p>
  </div>
  <div class="mv__bar">
    {
      storeys.length > 1 && (
        <label class="mv__floors">
          <span class="label">Plantas</span>
          <select class="mv__select" data-mv-storeys disabled>
            {[...storeys].reverse().map((s, i) => (
              <option value={s.key} selected={i === 0}>
                {i === 0 ? 'Edificio completo' : `Hasta ${s.label.toLowerCase()}`}
              </option>
            ))}
          </select>
        </label>
      )
    }
    {
      m.ifc && (
        <a class="mv__dl mono" href={url(m.ifc)} download>
          Descargar IFC
        </a>
      )
    }
  </div>
  {m.caption && <figcaption class="mv__cap muted">{m.caption}</figcaption>}
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-model-viewer]').forEach((root) => {
    const open = root.querySelector<HTMLButtonElement>('[data-mv-open]')!;
    const status = root.querySelector<HTMLElement>('[data-mv-status]')!;
    open.addEventListener('click', async () => {
      open.hidden = true;
      status.hidden = false;
      root.dataset.state = 'loading';
      try {
        const { mountModel } = await import('../scripts/model-viewer');
        await mountModel(root);
        root.querySelector('.mv__poster')?.remove();
        root.querySelectorAll<HTMLSelectElement>('[data-mv-storeys]').forEach((el) => (el.disabled = false));
      } catch (err) {
        console.error(err);
        status.textContent = 'No se pudo cargar el modelo 3D en este navegador.';
        root.dataset.state = 'error';
      }
    });
  });
</script>

<style>
  .mv {
    --mv-bg: #f3f1ea;
    margin: 0;
    max-width: 760px;
    display: grid;
    gap: 10px;
  }

  .mv__stage {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--mv-bg);
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .mv__stage :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
    cursor: grab;
  }

  .mv__poster {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .mv__open {
    position: absolute;
    left: 50%;
    bottom: 24px;
    translate: -50% 0;
    display: grid;
    gap: 4px;
    justify-items: center;
    padding: 10px 18px;
    border: 1.5px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
  }

  .mv__open[hidden],
  .mv__status[hidden] {
    display: none;
  }

  .mv__open:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  .mv__open-label {
    font-size: 1.0625rem;
    font-weight: 560;
  }

  .mv__open-sub {
    font-size: 0.6875rem;
    opacity: 0.8;
  }

  .mv__status {
    position: absolute;
    inset: auto 0 24px;
    text-align: center;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .mv__bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    align-items: center;
    justify-content: space-between;
  }

  .mv__floors {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .mv__select {
    min-height: 34px;
    padding: 4px 8px;
    border: 1px solid var(--line);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
  }

  .mv__select[disabled] {
    opacity: 0.45;
  }

  .mv__dl {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .mv__dl:hover {
    color: var(--ink);
  }

  .mv__cap {
    font-size: 0.8125rem;
  }

  @media (max-width: 640px) {
    .mv__stage {
      aspect-ratio: 4 / 3;
    }
  }
</style>
