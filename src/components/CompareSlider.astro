---
/** Comparador de dos versiones de un mismo plano (antes / después). */
import type { MediaItem } from '../content/types';
import { url } from '../lib/url';

interface Props {
  item: MediaItem & { compareWith: NonNullable<MediaItem['compareWith']> };
  code?: string;
}
const { item, code } = Astro.props;
const ratio = item.ratio ?? 1.414;
const id = `cmp-${Math.random().toString(36).slice(2, 8)}`;
---

<figure class="cmp" data-compare>
  <div class="cmp__stage" style={`aspect-ratio: ${ratio}`}>
    <img src={url(item.compareWith.src)} alt={item.compareWith.alt} class="cmp__img" loading="lazy" />
    <div class="cmp__after" data-compare-after>
      <img src={url(item.src!)} alt={item.alt} class="cmp__img" loading="lazy" />
    </div>
    <div class="cmp__handle" data-compare-handle aria-hidden="true"><span></span></div>
    <span class="cmp__tag cmp__tag--a mono">{item.compareWith.label ?? 'Antes'}</span>
    <span class="cmp__tag cmp__tag--b mono">{item.label ?? 'Después'}</span>
  </div>
  <div class="cmp__controls">
    <label for={id} class="label">Comparar versiones</label>
    <input id={id} type="range" min="0" max="100" value="50" data-compare-range />
  </div>
  {
    (item.caption || code) && (
      <figcaption class="cmp__cap">
        {code && <span class="mono cmp__code">{code}</span>}
        <span>{item.caption}</span>
      </figcaption>
    )
  }
</figure>

<style>
  .cmp {
    margin: 0;
    display: grid;
    gap: 10px;
  }

  .cmp__stage {
    position: relative;
    border: 1px solid var(--line);
    background: var(--sheet);
    overflow: hidden;
    touch-action: pan-y;
    cursor: ew-resize;
  }

  .cmp__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
    pointer-events: none;
  }

  .cmp__after {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 var(--pos, 50%));
    background: var(--sheet);
  }

  .cmp__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos, 50%);
    width: 0;
    border-left: 1.5px solid var(--accent);
  }

  .cmp__handle span {
    position: absolute;
    top: 50%;
    left: 0;
    translate: -50% -50%;
    width: 28px;
    height: 28px;
    background: var(--accent);
    clip-path: polygon(0 50%, 35% 15%, 35% 85%, 0 50%, 100% 50%, 65% 15%, 65% 85%, 100% 50%);
  }

  .cmp__tag {
    position: absolute;
    top: 12px;
    padding: 4px 8px;
    font-size: 0.6875rem;
    background: var(--ink);
    color: var(--paper);
  }

  .cmp__tag--a {
    left: 12px;
  }

  .cmp__tag--b {
    right: 12px;
    background: var(--accent);
  }

  .cmp__controls {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 16px;
  }

  input[type='range'] {
    accent-color: var(--accent);
    width: 100%;
  }

  .cmp__cap {
    display: flex;
    gap: 12px;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .cmp__code {
    color: var(--accent);
    font-size: 0.75rem;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('.cmp__stage')!;
    const range = root.querySelector<HTMLInputElement>('[data-compare-range]')!;
    const set = (v: number) => {
      const pos = Math.min(100, Math.max(0, v));
      stage.style.setProperty('--pos', `${pos}%`);
      range.value = String(Math.round(pos));
    };
    range.addEventListener('input', () => set(Number(range.value)));
    let dragging = false;
    const fromEvent = (e: PointerEvent) => {
      const r = stage.getBoundingClientRect();
      set(((e.clientX - r.left) / r.width) * 100);
    };
    stage.addEventListener('pointerdown', (e) => {
      dragging = true;
      stage.setPointerCapture(e.pointerId);
      fromEvent(e);
    });
    stage.addEventListener('pointermove', (e) => dragging && fromEvent(e));
    stage.addEventListener('pointerup', () => (dragging = false));
    stage.addEventListener('pointercancel', () => (dragging = false));
  });
</script>
