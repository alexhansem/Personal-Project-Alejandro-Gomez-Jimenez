---
/**
 * Visor de PDF para láminas y documentación técnica.
 * Usa pdf.js (cargado solo en esta página) y vuelve a renderizar al ampliar
 * para que las cotas y rótulos se lean nítidos.
 */
import type { GetStaticPaths } from 'astro';
import type { DocumentItem, Project } from '../../../../content/types';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { projects, sheetCode } from '../../../../lib/content';
import { url } from '../../../../lib/url';

export const getStaticPaths = (() =>
  projects.flatMap((project, index) =>
    (project.documents ?? []).map((doc) => ({
      params: { slug: project.slug, doc: doc.id },
      props: { project, doc, index },
    })),
  )) satisfies GetStaticPaths;

interface Props {
  project: Project;
  doc: DocumentItem;
  index: number;
}
const { project: p, doc, index } = Astro.props;
const src = url(doc.src);
const back = url(`/proyectos/${p.slug}/#documentos`);
---

<BaseLayout title={`${doc.title} · ${p.title}`} description={doc.description ?? p.summary} noindex={p.demo}>
  <div class="pdfv" data-pdf={src}>
    <div class="pdfv__bar">
      <div class="pdfv__id">
        <a class="mono pdfv__back" href={back}>← {sheetCode('P', index)}</a>
        <div>
          <h1 class="pdfv__title">{doc.title}</h1>
          <p class="mono muted pdfv__meta">
            {p.title}
            {doc.sheet && <> · {doc.sheet}</>}
            {p.demo && <span class="stamp stamp--demo">Demo</span>}
          </p>
        </div>
      </div>

      <div class="pdfv__tools" role="toolbar" aria-label="Controles del documento">
        <div class="pdfv__group">
          <button type="button" class="vbtn" data-act="prev" aria-label="Página anterior">←</button>
          <label class="mono pdfv__page">
            <span class="visually-hidden">Página</span>
            <input type="number" min="1" value="1" inputmode="numeric" data-page-input aria-label="Número de página" />
            <span>/ <span data-pages>–</span></span>
          </label>
          <button type="button" class="vbtn" data-act="next" aria-label="Página siguiente">→</button>
        </div>
        <div class="pdfv__group">
          <button type="button" class="vbtn" data-act="out" aria-label="Reducir">−</button>
          <span class="mono pdfv__zoom" data-zoom>–</span>
          <button type="button" class="vbtn" data-act="in" aria-label="Ampliar">+</button>
          <button type="button" class="vbtn vbtn--text" data-act="fit" title="Ajustar página (0)">Ajustar</button>
          <button type="button" class="vbtn vbtn--text pdfv__hide-sm" data-act="actual" title="100 % (1)">100 %</button>
        </div>
        <div class="pdfv__group">
          <a class="vbtn vbtn--text" href={src} target="_blank" rel="noopener">Abrir ↗</a>
          <a class="vbtn vbtn--text" href={src} download>Descargar</a>
        </div>
      </div>
    </div>

    <div class="pdfv__body">
      <ol class="pdfv__thumbs" data-thumbs aria-label="Páginas"></ol>
      <div class="pdfv__stage" data-stage tabindex="0" aria-label="Página del documento. Usa + y − para ampliar y las flechas para desplazarte.">
        <div class="pdfv__sheet" data-sheet>
          <canvas data-canvas></canvas>
        </div>
        <p class="pdfv__status mono" data-status>Cargando documento…</p>
      </div>
    </div>

    <noscript>
      <p class="pdfv__noscript">
        El visor necesita JavaScript. Puedes <a href={src}>abrir el PDF directamente</a>.
      </p>
    </noscript>
  </div>
</BaseLayout>

<style>
  .pdfv {
    display: grid;
    grid-template-rows: auto 1fr;
    height: calc(100dvh - 65px);
    min-height: 520px;
    border-bottom: 1px solid var(--ink);
  }

  .pdfv__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 24px;
    padding: 10px var(--gutter);
    border-bottom: 1px solid var(--ink);
    background: var(--paper);
  }

  .pdfv__id {
    display: flex;
    align-items: center;
    gap: 20px;
    min-width: 0;
  }

  .pdfv__back {
    text-decoration: none;
    white-space: nowrap;
  }

  .pdfv__title {
    font-size: 1.0625rem;
    font-weight: 560;
  }

  .pdfv__meta {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 0.6875rem;
  }

  .pdfv__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
  }

  .pdfv__group {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .pdfv__page {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    padding-inline: 4px;
  }

  .pdfv__page input {
    width: 3.2em;
    height: 40px;
    border: 1px solid var(--line);
    background: var(--sheet);
    font: inherit;
    text-align: center;
  }

  .pdfv__zoom {
    min-width: 5ch;
    text-align: center;
    font-size: 0.75rem;
  }

  .pdfv__body {
    display: grid;
    grid-template-columns: 140px 1fr;
    min-height: 0;
  }

  .pdfv__thumbs {
    list-style: none;
    overflow-y: auto;
    padding: 16px;
    display: grid;
    gap: 14px;
    align-content: start;
    border-right: 1px solid var(--line);
    background: var(--paper);
  }

  .pdfv__thumbs button {
    display: grid;
    gap: 4px;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .pdfv__thumbs canvas {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    background: #fff;
  }

  .pdfv__thumbs button[aria-current='true'] {
    color: var(--accent);
  }

  .pdfv__thumbs button[aria-current='true'] canvas {
    outline: 2px solid var(--accent);
  }

  .pdfv__stage {
    position: relative;
    overflow: hidden;
    cursor: grab;
    background:
      linear-gradient(var(--line-soft) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, var(--line-soft) 1px, transparent 1px) 0 0 / 32px 32px,
      #e9e6dd;
  }

  .pdfv__stage[data-dragging='true'] {
    cursor: grabbing;
  }

  .pdfv__sheet {
    background: #fff;
    box-shadow:
      0 0 0 1px var(--line),
      0 12px 32px rgb(27 27 25 / 0.12);
  }

  .pdfv__sheet canvas {
    width: 100%;
    height: 100%;
  }

  .pdfv__status {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    padding: 24px;
    text-align: center;
    color: var(--muted);
    pointer-events: none;
  }

  .pdfv__status[hidden] {
    display: none;
  }

  .pdfv__status a {
    pointer-events: auto;
  }

  .pdfv__noscript {
    padding: 24px var(--gutter);
  }

  @media (max-width: 960px) {
    .pdfv {
      height: calc(100dvh - 40px);
    }

    .pdfv__body {
      grid-template-columns: 1fr;
    }

    .pdfv__thumbs {
      display: none;
    }

    .pdfv__hide-sm {
      display: none;
    }
  }
</style>

<script>
  import { PanZoom } from '../../../../scripts/panzoom';
  import workerUrl from 'pdfjs-dist/legacy/build/pdf.worker.min.mjs?url';
  import type { PDFDocumentProxy, PDFPageProxy, RenderTask } from 'pdfjs-dist';

  // Se usa la build "legacy" de pdf.js para que funcione también en navegadores
  // que aún no tienen las APIs de JavaScript más recientes.
  const root = document.querySelector<HTMLElement>('[data-pdf]');

  async function init(root: HTMLElement) {
    const src = root.dataset.pdf!;
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const sheet = root.querySelector<HTMLElement>('[data-sheet]')!;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const pagesEl = root.querySelector<HTMLElement>('[data-pages]')!;
    const pageInput = root.querySelector<HTMLInputElement>('[data-page-input]')!;
    const zoomEl = root.querySelector<HTMLElement>('[data-zoom]')!;
    const thumbs = root.querySelector<HTMLOListElement>('[data-thumbs]')!;

    const fail = (msg: string) => {
      status.hidden = false;
      status.innerHTML = '';
      const p = document.createElement('span');
      p.textContent = msg + ' ';
      const a = document.createElement('a');
      a.href = src;
      a.textContent = 'Abrir el PDF directamente';
      status.append(p, a);
    };

    let pdfjs: typeof import('pdfjs-dist/legacy/build/pdf.mjs');
    try {
      pdfjs = await import('pdfjs-dist/legacy/build/pdf.mjs');
      pdfjs.GlobalWorkerOptions.workerSrc = workerUrl;
    } catch {
      fail('No se ha podido cargar el visor.');
      return;
    }

    let pdf: PDFDocumentProxy;
    try {
      pdf = await pdfjs.getDocument({ url: src }).promise;
    } catch {
      fail('No se ha podido abrir el documento. Comprueba que la ruta del PDF es correcta.');
      return;
    }

    let pageNum = 1;
    let page: PDFPageProxy | null = null;
    let task: RenderTask | null = null;
    let renderedScale = 0;

    // Límite de píxeles por lienzo para no agotar memoria en móviles.
    const MAX_PIXELS = 24_000_000;

    const render = async (scale: number) => {
      if (!page) return;
      const dpr = window.devicePixelRatio || 1;
      const base = page.getViewport({ scale: 1 });
      let s = scale * dpr;
      const pixels = base.width * base.height * s * s;
      if (pixels > MAX_PIXELS) s = Math.sqrt(MAX_PIXELS / (base.width * base.height));
      if (Math.abs(s - renderedScale) < 0.01) return;
      task?.cancel();
      const viewport = page.getViewport({ scale: s });
      const off = document.createElement('canvas');
      off.width = Math.floor(viewport.width);
      off.height = Math.floor(viewport.height);
      task = page.render({ canvas: off, viewport });
      try {
        await task.promise;
      } catch {
        return; // cancelado por un zoom posterior
      }
      canvas.width = off.width;
      canvas.height = off.height;
      canvas.getContext('2d')!.drawImage(off, 0, 0);
      renderedScale = s;
    };

    const pz = new PanZoom(stage, sheet, {
      maxScale: 8,
      onChange: ({ scale }) => (zoomEl.textContent = `${Math.round(scale * 100)} %`),
      onZoomEnd: (scale) => void render(scale),
    });

    const show = async (n: number) => {
      pageNum = Math.min(pdf.numPages, Math.max(1, n));
      pageInput.value = String(pageNum);
      thumbs.querySelectorAll('button').forEach((b, i) => b.setAttribute('aria-current', String(i + 1 === pageNum)));
      status.hidden = false;
      status.textContent = 'Cargando página…';
      page = await pdf.getPage(pageNum);
      const vp = page.getViewport({ scale: 1 });
      renderedScale = 0;
      pz.setContentSize(vp.width, vp.height);
      await render(pz.scale);
      status.hidden = true;
    };

    pagesEl.textContent = String(pdf.numPages);
    pageInput.max = String(pdf.numPages);

    root.addEventListener('click', (e) => {
      const act = (e.target as HTMLElement).closest<HTMLElement>('[data-act]')?.dataset.act;
      if (act === 'prev') void show(pageNum - 1);
      else if (act === 'next') void show(pageNum + 1);
      else if (act === 'in') pz.zoomBy(1.25);
      else if (act === 'out') pz.zoomBy(0.8);
      else if (act === 'fit') pz.fit();
      else if (act === 'actual') pz.actual();
    });

    pageInput.addEventListener('change', () => void show(Number(pageInput.value) || 1));

    stage.addEventListener('keydown', (e) => {
      if (pz.handleKey(e)) {
        e.preventDefault();
        return;
      }
      if (e.key === 'PageDown' || (e.key === 'ArrowRight' && pz.isFitted)) {
        e.preventDefault();
        void show(pageNum + 1);
      } else if (e.key === 'PageUp' || (e.key === 'ArrowLeft' && pz.isFitted)) {
        e.preventDefault();
        void show(pageNum - 1);
      }
    });

    await show(1);

    // Miniaturas (en segundo plano).
    for (let i = 1; i <= pdf.numPages; i++) {
      const li = document.createElement('li');
      const b = document.createElement('button');
      b.type = 'button';
      b.setAttribute('aria-label', `Ir a la página ${i}`);
      b.setAttribute('aria-current', String(i === pageNum));
      const c = document.createElement('canvas');
      const label = document.createElement('span');
      label.textContent = String(i).padStart(2, '0');
      b.append(c, label);
      b.addEventListener('click', () => void show(i));
      li.append(b);
      thumbs.append(li);
      const pg = await pdf.getPage(i);
      const v = pg.getViewport({ scale: 1 });
      const vp = pg.getViewport({ scale: 200 / v.width });
      c.width = Math.floor(vp.width);
      c.height = Math.floor(vp.height);
      await pg.render({ canvas: c, viewport: vp }).promise.catch(() => undefined);
    }
  }

  if (root) void init(root);
</script>
