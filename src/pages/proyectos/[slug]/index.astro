---
import type { GetStaticPaths } from 'astro';
import type { Project } from '../../../content/types';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MediaFigure from '../../../components/MediaFigure.astro';
import WorkflowTimeline from '../../../components/WorkflowTimeline.astro';
import ComparisonPanel from '../../../components/ComparisonPanel.astro';
import DataTable from '../../../components/DataTable.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import ProjectFiles from '../../../components/ProjectFiles.astro';
import SpeedBadge from '../../../components/SpeedBadge.astro';
import { getArea } from '../../../content/areas';
import TimeTag from '../../../components/TimeTag.astro';
import { getCategory } from '../../../content/categories';
import { projects, processes, sheetCode } from '../../../lib/content';
import { evaluateComparison, formatMinutes, formatPct, hasValue, summarizeWorkflow } from '../../../lib/time';
import { url } from '../../../lib/url';

export const getStaticPaths = (() =>
  projects.map((project, index) => ({ params: { slug: project.slug }, props: { project, index } }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
  index: number;
}
const { project: p, index } = Astro.props;
const code = sheetCode('P', index);
const media = p.media ?? [];
const hero = p.cover ?? media[0];
const group = p.slug;

const wf = p.workflow?.length ? summarizeWorkflow(p.workflow) : undefined;
// Una comparativa sin los dos totales no aporta nada a la ficha pública.
const cmpAll = p.comparison ? evaluateComparison(p.comparison) : undefined;
const cmp = cmpAll && cmpAll.status !== 'pendiente' ? cmpAll : undefined;
const showGen = !!wf && hasValue(wf.generation);
const showRev = !!wf && hasValue(wf.review);
const figures = p.figures ?? [];
const relatedProcesses = processes.filter((x) => x.relatedProjects?.includes(p.slug));

const prev = index > 0 ? projects[index - 1] : undefined;
const next = index < projects.length - 1 ? projects[index + 1] : undefined;

// Secciones presentes, numeradas en orden.
const has = {
  scope: !!p.scope?.stages.length,
  method: !!p.method?.steps.length,
  brief: !!(p.context || p.objective || p.problem),
  workflow: !!p.workflow?.length,
  comparison: !!cmp,
  tables: !!p.tables?.length,
  code: !!p.code?.length,
  work: !!(p.participation?.length || p.methodology?.length || p.deliverables?.length),
  results: !!(p.results?.length || p.checks?.length || p.limitations?.length),
  notes: !!p.notes,
};
const sectionDefs = [
  { key: 'scope', id: 'alcance', title: p.scope?.title ?? 'Alcance' },
  { key: 'method', id: 'metodo', title: p.method?.title ?? 'Método' },
  { key: 'brief', id: 'encargo', title: 'Encargo' },
  { key: 'workflow', id: 'secuencia', title: 'Secuencia de trabajo' },
  { key: 'comparison', id: 'comparativa', title: 'Comparativa de tiempos' },
  { key: 'tables', id: 'tablas', title: 'Tablas' },
  { key: 'code', id: 'codigo', title: 'Código' },
  { key: 'work', id: 'participacion', title: 'Participación y metodología' },
  { key: 'results', id: 'resultados', title: 'Resultados y comprobaciones' },
  { key: 'notes', id: 'observaciones', title: 'Observaciones' },
] as const;
const sections = sectionDefs.filter((s) => has[s.key]).map((s, i) => ({ ...s, n: String(i + 1).padStart(2, '0') }));
const sec = Object.fromEntries(sections.map((s) => [s.key, s])) as Record<string, (typeof sections)[number]>;

const ficha: { k: string; v: string }[] = [
  { k: 'Referencia', v: code },
  ...(p.period ? [{ k: 'Periodo', v: p.period }] : []),
  ...(p.status ? [{ k: 'Estado', v: p.status }] : []),
  ...(p.location ? [{ k: 'Ubicación', v: p.location }] : []),
  { k: p.categories.length > 1 ? 'Categorías' : 'Categoría', v: p.categories.map((c) => getCategory(c).label).join(' · ') },
  ...(p.tools?.length ? [{ k: 'Herramientas', v: p.tools.join(' · ') }] : []),
];

const skills = p.skills ?? [];
const delivered = p.delivered ?? [];
---

<BaseLayout title={p.title} description={p.tagline ?? p.summary} image={hero?.src} noindex={p.demo}>
  <article>
    <header class="container ph">
      <nav class="ph__crumbs mono" aria-label="Ruta">
        <a href={url('/proyectos/')}>Proyectos</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{code}</span>
      </nav>

      <div class="ph__grid">
        <div class="ph__title">
          {p.demo && <span class="stamp stamp--demo">Proyecto de demostración · contenido ficticio</span>}
          <h1>{p.title}</h1>
          <p class="lead">{p.tagline ?? p.summary}</p>
          <div class="ph__actions">
            <a class="btn btn--solid" href="#archivos">Ver los archivos</a>
            <a class="btn" href="#profesionales">Detalle técnico</a>
          </div>
        </div>
        {p.speed && (
          <div class="ph__speed">
            <SpeedBadge speed={p.speed} size="lg" />
          </div>
        )}
      </div>
    </header>

    {
      hero?.src && (
        <div class="container ph__hero">
          <MediaFigure item={hero} group={group} loading="eager" />
        </div>
      )
    }

    {
      delivered.length > 0 && (
        <section class="container dl" aria-labelledby="entregado">
          <h2 class="label dl__h" id="entregado">
            {p.speed ? `Lo que se entregó en ${p.speed.value.replace(/^<\s*/, 'menos de ')}` : 'Lo que se entregó'}
          </h2>
          <ul class="dl__list">
            {delivered.map((x) => (
              <li>
                <span class="dl__v">{x.value}</span>
                <span class="dl__l">{x.label}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="container section--tight" aria-labelledby="archivos-h">
      <div class="gv__head" id="archivos">
        <h2 class="gv__title" id="archivos-h">Archivos del proyecto</h2>
        <p class="muted gv__sub">Los originales, tal como se entregaron. Ábrelos, amplía y descarga.</p>
      </div>
      <ProjectFiles project={p} />
    </section>

    {
      skills.length > 0 && (
        <section class="container section--tight" aria-labelledby="demuestra">
          <div class="gv__head">
            <h2 class="gv__title" id="demuestra">Qué demuestra este proyecto</h2>
          </div>
          <ul class="sk">
            {skills.map((s) => (
              <li class="sk__item">
                <MediaFigure item={s.sample} group={group} crop={1.5} showCaption={false} />
                <p class="label sk__area">{getArea(s.area).title}</p>
                <p class="sk__text">{s.text}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      !!p.highlights?.length && (
        <section class="container hl" aria-labelledby="claves">
          <h2 class="gv__h" id="claves">Lo que lo hace especial</h2>
          <ol class="hl__list">
            {p.highlights.map((h, i) => (
              <li>
                <span class="hl__n mono">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="hl__title">{h.title}</h3>
                <p class="hl__text">{h.text}</p>
              </li>
            ))}
          </ol>
        </section>
      )
    }


    <section class="pro" aria-labelledby="profesionales-h">
      <div class="container">
        <div class="pro__head" id="profesionales">
          <p class="label pro__kicker">Para profesionales</p>
          <h2 class="pro__title" id="profesionales-h">Cómo se hizo, con detalle técnico</h2>
          <p class="pro__intro">{p.summary}</p>
        </div>

        <dl class="ph__ficha">
          {
            ficha.map((f) => (
              <div>
                <dt class="label">{f.k}</dt>
                <dd>{f.v}</dd>
              </div>
            ))
          }
        </dl>

    {
      (wf || cmp || figures.length > 0) && (
        <div class="pro__kpis">
          <dl class="kpis">
            {wf && !figures.length && (
              <div>
                <dt class="label">Pasos</dt>
                <dd class="kpis__v">
                  {p.workflow!.length}
                  <span class="kpis__sub mono">
                    {['ia', 'humano', 'software']
                      .map((a) => [a, p.workflow!.filter((s) => s.actor === a).length] as const)
                      .filter(([, n]) => n > 0)
                      .map(([a, n]) => `${n} ${a === 'ia' ? 'IA' : a === 'humano' ? 'propios' : 'software'}`)
                      .join(' · ')}
                  </span>
                </dd>
              </div>
            )}
            {figures.map((f) => (
              <div>
                <dt class="label">{f.label}</dt>
                <dd class="kpis__v">{f.value}</dd>
              </div>
            ))}
            {showGen && (
              <div>
                <dt class="label">Generación</dt>
                <dd>
                  <TimeTag time={wf!.generation} size="lg" />
                </dd>
              </div>
            )}
            {showRev && (
              <div>
                <dt class="label">Revisión</dt>
                <dd>
                  <TimeTag time={wf!.review} size="lg" />
                </dd>
              </div>
            )}
            {cmp && (
              <div class="kpis__delta">
                <dt class="label">Frente al método convencional</dt>
                <dd>
                  {cmp.status === 'valida' && cmp.differenceMinutes !== undefined ? (
                    <span class="kpis__v kpis__v--accent">
                      {cmp.differenceMinutes >= 0 ? '−' : '+'}
                      {formatMinutes(Math.abs(cmp.differenceMinutes))}
                      {cmp.differencePct !== undefined && (
                        <span class="kpis__sub mono">
                          {cmp.differencePct >= 0 ? '−' : '+'}
                          {formatPct(cmp.differencePct)} total medido
                        </span>
                      )}
                    </span>
                  ) : (
                    <span class="kpis__pending mono">No calculado: hay estimaciones</span>
                  )}
                </dd>
              </div>
            )}
          </dl>
        </div>
      )
    }


        {
          sections.length > 0 && (
            <div class="pro__actions">
              <button type="button" class="btn" data-pro-toggle>Desplegar todo</button>
            </div>
          )
        }

        <div class="pro__list">
    {
      sec.scope && p.scope && (
        <details class="pro__item" id={sec.scope.id}>
          <summary class="pro__sum">
            <span class="mono pro__n">{sec.scope.n}</span>
            <span class="pro__t">{sec.scope.title}</span>
          </summary>
          <div class="pro__body">
          {p.scope.intro && <p class="lead scope__intro">{p.scope.intro}</p>}
          <ol class="scope">
            {p.scope.stages.map((st, i) => (
              <li class="scope__stage">
                <span class="scope__n mono">Fase {i + 1}</span>
                <h3 class="scope__title">{st.title}</h3>
                <p class="scope__text">{st.text}</p>
                {!!st.outputs?.length && (
                  <ul class="scope__out mono">
                    {st.outputs.map((o) => (
                      <li>{o}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>
          {!!p.scope.audiences?.length && (
            <div class="aud">
              {p.scope.audiences.map((a) => (
                <div class="aud__card">
                  <p class="label aud__who">{a.audience}</p>
                  <h3 class="aud__title">{a.title}</h3>
                  <p class="aud__text">{a.text}</p>
                  {!!a.items?.length && (
                    <ul class="list-dash aud__items">
                      {a.items.map((x) => (
                        <li>{x}</li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
            </div>
          )}
          </div>
        </details>
      )
    }

    {
      sec.method && p.method && (
        <details class="pro__item" id={sec.method.id}>
          <summary class="pro__sum">
            <span class="mono pro__n">{sec.method.n}</span>
            <span class="pro__t">{sec.method.title}</span>
          </summary>
          <div class="pro__body">
          {p.method.intro && <p class="lead method__intro">{p.method.intro}</p>}
          <ol class="method">
            {p.method.steps.map((st, i) => (
              <li class="method__step">
                <span class="method__n mono">{String(i + 1).padStart(2, '0')}</span>
                {st.value && (
                  <p class="method__value">
                    {st.value}
                    {st.valueNote && <span class="method__vnote mono">{st.valueNote}</span>}
                  </p>
                )}
                <h3 class="method__title">{st.title}</h3>
                <p class="method__text">{st.text}</p>
              </li>
            ))}
          </ol>
          </div>
        </details>
      )
    }

    {
      sec.brief && (
        <details class="pro__item" id={sec.brief.id}>
          <summary class="pro__sum">
            <span class="mono pro__n">{sec.brief.n}</span>
            <span class="pro__t">{sec.brief.title}</span>
          </summary>
          <div class="pro__body">
          <dl class="brief">
            {p.context && (
              <div>
                <dt class="label">Contexto</dt>
                <dd>{p.context}</dd>
              </div>
            )}
            {p.objective && (
              <div>
                <dt class="label">Objetivo</dt>
                <dd>{p.objective}</dd>
              </div>
            )}
            {p.problem && (
              <div>
                <dt class="label">Problema a resolver</dt>
                <dd>{p.problem}</dd>
              </div>
            )}
          </dl>
          </div>
        </details>
      )
    }

    {
      sec.workflow && p.workflow && (
        <details class="pro__item" id={sec.workflow.id}>
          <summary class="pro__sum">
            <span class="mono pro__n">{sec.workflow.n}</span>
            <span class="pro__t">{sec.workflow.title}</span>
          </summary>
          <div class="pro__body">
          <WorkflowTimeline steps={p.workflow} group={`${group}-wf`} />
          </div>
        </details>
      )
    }

    {
      sec.comparison && p.comparison && (
        <details class="pro__item" id={sec.comparison.id}>
          <summary class="pro__sum">
            <span class="mono pro__n">{sec.comparison.n}</span>
            <span class="pro__t">{sec.comparison.title}</span>
          </summary>
          <div class="pro__body">
          <ComparisonPanel comparison={p.comparison} />
          </div>
        </details>
      )
    }

    {
      sec.tables && p.tables && (
        <details class="pro__item" id={sec.tables.id}>
          <summary class="pro__sum">
            <span class="mono pro__n">{sec.tables.n}</span>
            <span class="pro__t">{sec.tables.title}</span>
          </summary>
          <div class="pro__body">
          <div class="stack">
            {p.tables.map((t, i) => (
              <DataTable table={t} code={`T-${String(i + 1).padStart(2, '0')}`} />
            ))}
          </div>
          </div>
        </details>
      )
    }

    {
      sec.code && p.code && (
        <details class="pro__item" id={sec.code.id}>
          <summary class="pro__sum">
            <span class="mono pro__n">{sec.code.n}</span>
            <span class="pro__t">{sec.code.title}</span>
          </summary>
          <div class="pro__body">
          <div class="stack">
            {p.code.map((s) => (
              <CodeBlock snippet={s} demo={p.demo} />
            ))}
          </div>
          </div>
        </details>
      )
    }

    {
      sec.work && (
        <details class="pro__item" id={sec.work.id}>
          <summary class="pro__sum">
            <span class="mono pro__n">{sec.work.n}</span>
            <span class="pro__t">{sec.work.title}</span>
          </summary>
          <div class="pro__body">
          <div class="cols">
            {!!p.participation?.length && (
              <div>
                <h3 class="label col-h">Participación concreta</h3>
                <ul class="list-dash">
                  {p.participation.map((x) => (
                    <li>{x}</li>
                  ))}
                </ul>
              </div>
            )}
            {!!p.methodology?.length && (
              <div>
                <h3 class="label col-h">Metodología</h3>
                <ol class="list-num">
                  {p.methodology.map((x) => (
                    <li>{x}</li>
                  ))}
                </ol>
              </div>
            )}
            {!!p.deliverables?.length && (
              <div>
                <h3 class="label col-h">Entregables</h3>
                <ul class="list-dash">
                  {p.deliverables.map((x) => (
                    <li>{x}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
          </div>
        </details>
      )
    }

    {
      sec.results && (
        <details class="pro__item" id={sec.results.id}>
          <summary class="pro__sum">
            <span class="mono pro__n">{sec.results.n}</span>
            <span class="pro__t">{sec.results.title}</span>
          </summary>
          <div class="pro__body">
          <div class="cols">
            {!!p.results?.length && (
              <div>
                <h3 class="label col-h">Resultados</h3>
                <ul class="list-dash">
                  {p.results.map((x) => (
                    <li>{x}</li>
                  ))}
                </ul>
              </div>
            )}
            {!!p.checks?.length && (
              <div>
                <h3 class="label col-h">Comprobaciones realizadas</h3>
                <ul class="list-dash">
                  {p.checks.map((x) => (
                    <li>{x}</li>
                  ))}
                </ul>
              </div>
            )}
            {!!p.limitations?.length && (
              <div>
                <h3 class="label col-h">Limitaciones</h3>
                <ul class="list-dash">
                  {p.limitations.map((x) => (
                    <li>{x}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
          </div>
        </details>
      )
    }

    {
      sec.notes && (
        <details class="pro__item" id={sec.notes.id}>
          <summary class="pro__sum">
            <span class="mono pro__n">{sec.notes.n}</span>
            <span class="pro__t">{sec.notes.title}</span>
          </summary>
          <div class="pro__body">
          <p class="prose">{p.notes}</p>
          </div>
        </details>
      )
    }
        </div>

    {
      relatedProcesses.length > 0 && (
        <aside class="pro__related" aria-labelledby="relacionados">
          <h2 class="label" id="relacionados">
            Procesos y herramientas relacionados
          </h2>
          <ul class="related">
            {relatedProcesses.map((r) => (
              <li>
                <a href={url(`/procesos/${r.slug}/`)}>
                  <span class="mono muted">{r.type}</span>
                  <span>{r.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
      </div>
    </section>

    <nav class="container pager" aria-label="Otros proyectos">
      {
        prev ? (
          <a class="pager__link" href={url(`/proyectos/${prev.slug}/`)} rel="prev">
            <span class="mono muted">← {sheetCode('P', index - 1)}</span>
            <span>{prev.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="pager__link pager__link--next" href={url(`/proyectos/${next.slug}/`)} rel="next">
            <span class="mono muted">{sheetCode('P', index + 1)} →</span>
            <span>{next.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<script>
  // Las secciones técnicas van plegadas. Un enlace con #ancla las abre, y el
  // botón «Desplegar todo» las abre o cierra a la vez.
  const openFromHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = id ? document.getElementById(id) : null;
    const details = target?.closest('details');
    if (details && !details.open) {
      details.open = true;
      target!.scrollIntoView();
    }
  };
  openFromHash();
  window.addEventListener('hashchange', openFromHash);

  const toggle = document.querySelector<HTMLButtonElement>('[data-pro-toggle]');
  const items = [...document.querySelectorAll<HTMLDetailsElement>('.pro__item')];
  const sync = () => {
    if (toggle) toggle.textContent = items.every((d) => d.open) ? 'Plegar todo' : 'Desplegar todo';
  };
  items.forEach((d) => d.addEventListener('toggle', sync));
  toggle?.addEventListener('click', () => {
    const open = !items.every((d) => d.open);
    items.forEach((d) => (d.open = open));
    sync();
  });
</script>

<style>
  .ph {
    padding-block: clamp(28px, 4vw, 56px) clamp(24px, 3vw, 40px);
  }

  .ph__crumbs {
    display: flex;
    gap: 10px;
    font-size: 0.75rem;
    color: var(--muted);
    margin-bottom: clamp(20px, 3vw, 40px);
  }

  .ph__crumbs a {
    text-decoration: none;
  }

  .ph__grid {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: end;
  }

  .ph__title {
    display: grid;
    gap: 18px;
    justify-items: start;
  }

  .ph__title h1 {
    font-size: var(--step-3);
    font-weight: 540;
    letter-spacing: -0.03em;
    max-width: 22ch;
  }

  .ph__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 4px;
  }

  .ph__speed {
    padding-top: 16px;
    border-top: 1.5px solid var(--accent);
  }

  .ph__ficha {
    margin: 0 0 clamp(24px, 3vw, 40px);
    border-top: 1.5px solid var(--ink);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    column-gap: var(--col-gap);
  }

  .ph__ficha div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
  }

  .ph__ficha dd {
    margin: 0;
  }

  .ph__hero {
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .dl {
    margin-bottom: clamp(8px, 2vw, 24px);
  }

  .dl__h {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--ink);
  }

  .dl__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  }

  .dl__list {
    column-gap: 20px;
  }

  .dl__list li {
    display: grid;
    gap: 4px;
    align-content: start;
    padding: 16px 0 18px;
    border-bottom: 1px solid var(--line);
  }

  .dl__v {
    font-size: var(--step-3);
    font-weight: 560;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .dl__l {
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.35;
  }

  .gv__head {
    display: grid;
    gap: 6px;
