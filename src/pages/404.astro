---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Página no encontrada" noindex>
  <div class="container page-head nf">
    <p class="label">Error 404</p>
    <h1>Esta hoja no existe</h1>
    <p class="lead">La dirección no corresponde a ninguna página. Puede que el proyecto se haya retirado o renombrado.</p>
    <p><a class="btn btn--solid" href={url('/proyectos/')}>Ir a proyectos</a></p>
  </div>
</BaseLayout>

<style>
  .nf {
    min-height: 50vh;
    align-content: center;
    justify-items: start;
  }
</style>
