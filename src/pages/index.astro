---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import MediaFigure from '../components/MediaFigure.astro';
import EmptyState from '../components/EmptyState.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { profile } from '../config/profile';
import { featuredProjects, projectIndex, projects, sheetCode } from '../lib/content';
import { areaShowcase } from '../lib/files';
import { url } from '../lib/url';
import { siteKicker } from '../config/site';

const experience = profile.experience ?? [];
const hasCareer = profile.education.length > 0 || experience.length > 0;
const timed = projects.filter((p) => p.speed);
// numeración de las secciones según las que se muestran
const codes = (() => {
  let n = 0;
  const next = () => String(++n).padStart(2, '0');
  return {
    projects: next(),
    areas: areaShowcase.length ? next() : '',
    career: hasCareer ? next() : '',
    pro: next(),
    contact: next(),
  };
})();
---

<BaseLayout>
  <section class="hero container">
    <div class="hero__main">
      <p class="label hero__kicker">{siteKicker}</p>
      <h1 class="hero__name">
        {profile.name}
        {profile.isExample && <span class="stamp stamp--demo hero__stamp">Ejemplo</span>}
      </h1>
      <p class="hero__headline">{profile.plainHeadline ?? profile.headline}</p>
      <p class="lead hero__intro">{profile.plainIntro ?? profile.intro}</p>
      {
        profile.software.length > 0 && (
          <p class="hero__tools">
            <span class="label">Software</span>
            {profile.software.map((s) => <span class="mono hero__tool">{s}</span>)}
          </p>
        )
      }
      <div class="hero__actions">
        <a class="btn btn--solid" href="#proyectos">Ver los proyectos</a>
        <a class="btn" href="#que-hago">Qué sé hacer</a>
      </div>
    </div>

    {
      timed.length > 0 && (
        <aside class="hero__index" aria-labelledby="tiempos">
          <div class="hero__index-head">
            <h2 id="tiempos" class="label">Tiempo de cada proyecto</h2>
            <span class="mono muted">del inicio a la entrega</span>
          </div>
          <ul class="speeds">
            {timed.map((p) => (
              <li>
                <a href={url(`/proyectos/${p.slug}/`)}>
                  <span class="speeds__v">{p.speed!.value}</span>
                  <span class="speeds__t">
                    <span class="speeds__title">{p.title}</span>
                    <span class="speeds__label muted">{p.speed!.label}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <p class="mono muted speeds__src">Tiempos totales indicados por el autor, sin desglose por fases.</p>
        </aside>
      )
    }
  </section>

  <section class="section--tight container" aria-labelledby="proyectos">
    <SectionHead code={codes.projects} title="Proyectos" id="proyectos">
      {projects.length > featuredProjects.length && <a class="link-arrow" href={url('/proyectos/')}>Todos los proyectos</a>}
    </SectionHead>
    {
      featuredProjects.length ? (
        <div class="showcases">
          {featuredProjects.map((p, i) => (
            <ProjectShowcase project={p} code={sheetCode('P', projectIndex(p.slug))} flip={i % 2 === 1} />
          ))}
        </div>
      ) : (
        <EmptyState
          title="Todavía no hay proyectos publicados."
          text="Los primeros trabajos se están preparando. Cada uno mostrará planos, documentos y cómo se desarrolló."
          sheet="P-01"
          hint="Añade un archivo en src/content/projects/ (copia _PLANTILLA.ts.txt) y marca published: true."
        />
      )
    }
  </section>

  {
    areaShowcase.length > 0 && (
      <section class="section--tight container" aria-labelledby="que-hago">
        <SectionHead code={codes.areas} title="Qué sé hacer" id="que-hago">
          <span class="mono muted">Cada área, con una muestra real</span>
        </SectionHead>
        <ol class="areas">
          {areaShowcase.map(({ area, samples }, i) => (
            <li class="areas__item">
              <MediaFigure item={samples[0].sample} group="areas" crop={1.5} showCaption={false} />
              <p class="mono areas__n">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="areas__title">{area.title}</h3>
              <p class="areas__text">{area.text}</p>
              <p class="areas__in">
                <span class="label">Muestras en</span>
                {samples.map((s) => (
                  <a href={url(`/proyectos/${s.project.slug}/#demuestra`)}>{s.project.title}</a>
                ))}
              </p>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    hasCareer && (
      <section class="section--tight container" aria-labelledby="trayectoria">
        <SectionHead code={codes.career} title="Trayectoria" id="trayectoria" />
        <div class="career">
          {experience.length > 0 && (
            <div>
              <h3 class="label career__head">Experiencia</h3>
              <ol class="career__list">
                {experience.map((e) => (
                  <li>
                    <p class="mono muted career__period">{e.period}</p>
                    <p class="career__title">{e.role}</p>
                    <p class="muted career__org">{e.org}</p>
                    {e.text && <p class="career__text">{e.text}</p>}
                  </li>
                ))}
              </ol>
            </div>
          )}
          <div>
            {profile.education.length > 0 && (
              <>
                <h3 class="label career__head">Formación</h3>
                <ol class="career__list">
                  {profile.education.map((e) => (
                    <li>
                      <p class="mono muted career__period">{e.period}</p>
                      <p class="career__title">{e.title}</p>
                      {e.center && <p class="muted career__org">{e.center}</p>}
                    </li>
                  ))}
                </ol>
              </>
            )}
            {profile.certifications && profile.certifications.length > 0 && (
              <>
                <h3 class="label career__head career__head--gap">Certificaciones</h3>
                <ul class="career__certs">
                  {profile.certifications.map((c) => <li>{c}</li>)}
                </ul>
              </>
            )}
          </div>
        </div>
      </section>
    )
  }

  <section class="section--tight container" aria-labelledby="para-profesionales">
    <SectionHead code={codes.pro} title="Para profesionales" id="para-profesionales" />
    <div class="pro">
      <p class="pro__text">
        Cada proyecto guarda también su lado técnico: la secuencia de trabajo entre la IA, el software y la revisión
        propia, el método, las tablas de datos, el código y las limitaciones. Está al final de cada ficha, plegado.
      </p>
      <ul class="pro__links">
        {projects.map((p) => (
          <li>
            <a href={url(`/proyectos/${p.slug}/#profesionales`)}>
              <span class="mono">{sheetCode('P', projectIndex(p.slug))}</span> Detalle técnico · {p.title}
            </a>
          </li>
        ))}
        <li>
          <a href={url('/metodologia/')}>
            <span class="mono">—</span> Metodología y registro de tiempos
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="section--tight container" aria-labelledby="contacto">
    <SectionHead code={codes.contact} title="Contacto" id="contacto" />
    <ContactLinks layout="inline" />
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 5vw, 96px);
    padding-block: clamp(40px, 6vw, 88px) clamp(40px, 5vw, 72px);
    align-items: end;
  }

  .hero__main {
    display: grid;
    gap: 20px;
    align-content: end;
  }

  .hero__name {
    font-size: var(--step-4);
    font-weight: 540;
    letter-spacing: -0.035em;
    line-height: 0.98;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }

  .hero__stamp {
    font-size: 0.75rem;
  }

  .hero__headline {
    font-size: var(--step-2);
    line-height: 1.22;
    letter-spacing: -0.015em;
    max-width: 34ch;
  }

  .hero__intro {
    max-width: 58ch;
  }

  .career {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 5vw, 96px);
  }

  .career__head {
    margin: 0 0 8px;
  }

  .career__head--gap {
    margin-top: 32px;
  }

  .career__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .career__list li {
    display: grid;
    gap: 2px;
    padding-block: 14px;
    border-top: 1px solid var(--line);
  }

  .career__list p {
    margin: 0;
  }

  .career__period {
    font-size: 0.75rem;
  }

  .career__title {
    font-weight: 540;
  }

  .career__org {
    font-size: 0.9375rem;
  }

  .career__text {
    margin-top: 6px !important;
    max-width: 62ch;
    font-size: 0.9375rem;
  }

  .career__certs {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: 4px;
  }

  @media (max-width: 860px) {
    .career {
      grid-template-columns: 1fr;
    }
  }

  .hero__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
    align-items: center;
    margin: 0;
  }

  .hero__tools .label {
    margin-right: 4px;
  }

  .hero__tool {
    padding: 3px 8px;
    border: 1px solid var(--line);
    font-size: 0.75rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }

  .hero__index {
    border-top: 1.5px solid var(--ink);
    align-self: end;
  }

  .hero__index-head {
    display: flex;
    justify-content: space-between;
    padding-block: 10px;
    border-bottom: 1px solid var(--ink);
    font-size: 0.75rem;
  }

  .hero__index-head h2 {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--ink);
  }

  .speeds {
    list-style: none;
  }

  .speeds a {
    display: grid;
    grid-template-columns: minmax(6.5rem, auto) 1fr;
    gap: 18px;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: padding var(--t-fast) var(--ease);
  }

  .speeds a:hover {
    padding-left: 8px;
  }

  .speeds__v {
    font-size: clamp(2.2rem, 1.6rem + 2vw, 3.4rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--accent);
    white-space: nowrap;
  }

  .speeds__t {
    display: grid;
    gap: 2px;
  }

  .speeds__title {
    font-weight: 560;
    line-height: 1.25;
  }

  .speeds__label {
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .speeds__src {
    padding-top: 10px;
    font-size: 0.6875rem;
  }

  .showcases {
    display: grid;
    gap: clamp(56px, 7vw, 112px);
  }

  .areas {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(32px, 4vw, 56px) var(--col-gap);
  }

  .areas__item {
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .areas__n {
    margin-top: 6px;
    font-size: 0.75rem;
    color: var(--accent);
  }

  .areas__title {
    font-size: var(--step-2);
    letter-spacing: -0.02em;
  }

  .areas__text {
    color: var(--ink-2);
    max-width: 46ch;
  }

  .areas__in {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    align-items: baseline;
    font-size: 0.875rem;
    margin-top: 2px;
  }

  .pro {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: clamp(24px, 4vw, 64px);
  }

  .pro__text {
    font-size: 1.0625rem;
    color: var(--ink-2);
    max-width: 58ch;
  }

  .pro__links {
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .pro__links a {
    display: flex;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .pro__links .mono {
    min-width: 3rem;
    font-size: 0.75rem;
    color: var(--accent);
    padding-top: 0.2em;
  }

  @media (max-width: 960px) {
    .hero,
    .pro {
      grid-template-columns: 1fr;
    }

    .areas {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .areas {
      grid-template-columns: 1fr;
    }
  }
</style>
